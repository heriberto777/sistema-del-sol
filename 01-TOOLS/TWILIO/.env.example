# TWILIO — notificaciones de WhatsApp (backend/src/whatsapp-bot/, bandeja)
# Dashboard: https://console.twilio.com
#
# Copy this file to `.env`, fill in real values, and `chmod 600 .env`.
# TWILIO_WHATSAPP_FROM va con el prefijo "whatsapp:", ej: "whatsapp:+14155238886"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
