# ANTHROPIC — generate at https://console.anthropic.com/settings/keys
#
# Copy this file to `.env`, fill in real values, and `chmod 600 .env`.
# Usado por backend/src/ia/ — sin ANTHROPIC_API_KEY, cada endpoint de /ia
# degrada a un modo heurístico sin IA (nunca falla la request).

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
