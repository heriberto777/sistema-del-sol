# STRIPE — operational credentials
# Generate at: https://dashboard.stripe.com/apikeys
#
# Copy this file to `.env`, fill in real values, and `chmod 600 .env`.
# Usado por backend/src/facturacion-plataforma/pasarela/ (StripeAdapter) —
# sin STRIPE_SECRET_KEY, el checkout devuelve 503 (pagos en línea
# deshabilitados), nunca bloquea el resto del backend.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
