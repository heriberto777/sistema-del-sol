# === DATABASE ===
POSTGRES_USER=sol
POSTGRES_PASSWORD=sol
POSTGRES_DB=sistema_del_sol
POSTGRES_PORT=5432
DATABASE_URL="postgresql://sol:sol@127.0.0.1:5432/sistema_del_sol"

# Rol de Postgres restringido (sin superusuario, sin BYPASSRLS) que usa
# TenantPrismaService para el tráfico HTTP normal — separado del rol de
# arriba, que sigue corriendo migraciones y siendo dueño de las tablas.
# Crear/actualizar con: pnpm --filter ./backend db:app-role (una vez, antes
# de db:rls). Ver docs/ARCHITECTURE.md, sección "Multi-tenancy".
APP_DB_USER=sol_app
APP_DB_PASSWORD=sol_app
APP_DATABASE_URL="postgresql://sol_app:sol_app@127.0.0.1:5432/sistema_del_sol"

# === REDIS ===
REDIS_PORT=6379
REDIS_URL="redis://127.0.0.1:6379"

# === JWT (usuarios de tenant) ===
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRATION="24h"

# === JWT DE PLATAFORMA (super admin, separado del de tenants) ===
PLATFORM_JWT_SECRET="cambia-este-otro-secreto-en-produccion"
PLATFORM_JWT_EXPIRATION="12h"
# Bootstrap del primer super admin: pnpm --filter ./backend platform:bootstrap-admin
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""
PLATFORM_ADMIN_NOMBRE="Super Admin"

# === NODE ===
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173
# URL pública del frontend, usada para armar el link de "olvidé mi
# contraseña" en el correo. En docker-compose se deriva de FRONTEND_PORT.
FRONTEND_URL="http://localhost:5173"

# === n8n ===
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL="http://localhost:5678/"

# === EMAIL (notificaciones) ===
EMAIL_HABILITADO=true
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@sistemadelsol.com"

# === WHATSAPP (notificaciones, vía la API de Twilio) ===
# Sin estas tres variables, WhatsAppChannel loguea y no envía (igual que
# EMAIL_HABILITADO=false para el correo) — no bloquea nada en desarrollo.
# TWILIO_WHATSAPP_FROM va con el prefijo "whatsapp:", ej: "whatsapp:+14155238886"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# === IA (asistente de negocio, sugerencia de cuenta contable, descripción
# de producto — vía la Messages API de Anthropic) ===
# Sin ANTHROPIC_API_KEY, cada endpoint de /ia cae a un modo heurístico sin
# IA (ver IaClientService) — no bloquea nada en desarrollo.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# === PASARELA DE PAGO (cobro en línea de facturas de plataforma al tenant) ===
# Sin STRIPE_SECRET_KEY, el checkout devuelve 503 (pagos en línea
# deshabilitados) — no bloquea nada en desarrollo. Clave de prueba
# (sk_test_...) desde el dashboard de Stripe; STRIPE_WEBHOOK_SECRET
# (whsec_...) sale de `stripe listen` (Stripe CLI) en local o del
# webhook configurado en el dashboard en producción. STRIPE_CURRENCY:
# Stripe no liquida en DOP directo — se cobra en esta moneda con el
# mismo monto numérico de la factura (sin conversión), ver ARCHITECTURE.md.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="usd"
# stripe | azul | cardnet — azul/cardnet son adaptadores stub todavía
PASARELA_PAGO_ACTIVA="stripe"

# === MSSQL (opcional, por tenant se puede sobreescribir en tenant_settings) ===
MSSQL_HOST=""
MSSQL_PORT=1433
MSSQL_USER=""
MSSQL_PASSWORD=""
MSSQL_DATABASE=""

# === PARAMETROS DE NEGOCIO (defaults, configurable por tenant) ===
ITBIS_GENERAL=18
ITBIS_REDUCIDA=8
PLAZO_PAGO_DIAS=30
LIMITE_APROBACION_PCT=50
PERIODO_HISTORICO_MESES=3
STOCK_MINIMO_DEFAULT=10
BACKUP_FRECUENCIA=daily
