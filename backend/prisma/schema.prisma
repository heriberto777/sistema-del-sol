generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE: TENANTS & CONFIGURACIÓN
// ============================================================

enum EstadoTenant {
  ACTIVO
  SUSPENDIDO
  CANCELADO
}

model Tenant {
  id                   String               @id @default(uuid())
  nombre               String
  rnc                  String?
  subdominio           String               @unique
  estado               EstadoTenant         @default(ACTIVO)
  // Qué módulos tiene disponibles este tenant — ver ModuloActivoGuard.
  // Nullable a propósito: un tenant recién creado sin plan asignado cae
  // al fallback "denegar" del guard hasta que plataforma le asigne uno
  // (los tenants ya existentes se backfillean a un plan al migrar).
  planId               String?
  plan                 Plan?                @relation(fields: [planId], references: [id])
  // Ver ModalidadFacturacion — vive acá (no en TenantSettings) porque a
  // diferencia de esa tabla, Tenant siempre tiene una fila garantizada
  // desde su creación (TenantSettings hoy no se crea en ningún flujo).
  modalidadFacturacion ModalidadFacturacion @default(NCF)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  settings                  TenantSettings?
  configuraciones           Configuracion[]
  modulosOverride           TenantModuloOverride[]
  users                     User[]
  roles                     Role[]
  auditLogs                 AuditLog[]
  facturas                  Factura[]
  ncfAsignados              NcfAsignado[]
  correlativos              Correlativo[]
  productos                 Producto[]
  categorias                Categoria[]
  variantesProducto         VarianteProducto[]
  atributos                 Atributo[]
  bodegas                   Bodega[]
  sucursales                Sucursal[]
  movimientosInventario     MovimientoInventario[]
  clientes                  Cliente[]
  categoriasCliente         CategoriaCliente[]
  feriados                  Feriado[]
  puestos                   Puesto[]
  leyesFiscales             LeyFiscal[]
  plantillasHorario         PlantillaHorario[]
  tiposAusenciaConfig       TipoAusenciaConfig[]
  codigosAutorizacion       CodigoAutorizacion[]
  comisionesVenta           ComisionVenta[]
  configuracionLealtad      ConfiguracionLealtad?
  movimientosLealtad        MovimientoLealtad[]
  cajas                     Caja[]
  tasasCambio               TasaCambio[]
  proveedores               Proveedor[]
  ordenesCompra             OrdenCompra[]
  ajustesInventario         AjusteInventario[]
  transferenciasInventario  TransferenciaInventario[]
  webhooks                  Webhook[]
  notificaciones            Notificacion[]
  plantillasNotificacion    NotificacionPlantilla[]
  ofertas                   Oferta[]
  bonos                     Bono[]
  lotes                     Lote[]
  cotizaciones              Cotizacion[]
  remisiones                Remision[]
  cuentasContables          CuentaContable[]
  asientosContables         AsientoContable[]
  periodosContablesCerrados PeriodoContableCerrado[]
  empleados                 Empleado[]
  periodosNomina            PeriodoNomina[]
  turnosCaja                TurnoCaja[]
  pagos                     Pago[]
  formasPago                FormaPago[]
  listasPrecio              ListaPrecio[]
  cuentasBancarias          CuentaBancaria[]
  gastosMenores             GastoMenor[]
  horariosEmpleado          HorarioEmpleado[]
  registrosAsistencia       RegistroAsistencia[]
  ausencias                 Ausencia[]
  suscripcion               Suscripcion?
  facturasPlataforma        FacturaPlataforma[]
  ventasAparcadas           VentaAparcada[]
  carritosBorrador          CarritoBorrador[]
  whatsappConfig            WhatsappConfigTenant?
  whatsappMensajes          WhatsappMensaje[]
  pasarelaConfig            PasarelaConfigTenant?
  sesionesCobroFactura      SesionCobroFactura[]

  @@map("tenants")
}

// Administradores de la PLATAFORMA (tú, tu equipo) — deliberadamente sin
// tenantId: no pertenecen a ningún tenant, gestionan el alta/baja de
// tenants. Login y JWT separados de los usuarios de tenant (ver
// src/platform-auth/).
model PlatformAdmin {
  id                     String        @id @default(uuid())
  email                  String        @unique
  passwordHash           String
  nombre                 String
  activo                 Boolean       @default(true)
  resetPasswordTokenHash String?
  resetPasswordExpiraEn  DateTime?
  createdAt              DateTime      @default(now())
  roleId                 String?
  role                   PlatformRole? @relation(fields: [roleId], references: [id])

  auditLogs                  PlatformAuditLog[]
  pagosPlataformaRegistrados PagoPlataforma[]

  @@map("platform_admins")
}

// RBAC de plataforma (equipo del super admin) — catálogo global, mismo
// patrón que Role/Permission de tenants pero sin tenantId. roleId es
// nullable en PlatformAdmin a propósito: sin rol asignado, el guard
// deniega cualquier ruta que pida un permiso puntual (fallback seguro).
model PlatformPermission {
  id    String @id @default(uuid())
  clave String @unique

  roles PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformRole {
  id        String   @id @default(uuid())
  nombre    String   @unique
  createdAt DateTime @default(now())

  permisos PlatformRolePermission[]
  admins   PlatformAdmin[]

  @@map("platform_roles")
}

model PlatformRolePermission {
  roleId       String
  role         PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("platform_role_permissions")
}

// Datos estructurados de integración/config por tenant (MSSQL, canales habilitados, moneda)
model TenantSettings {
  id                     String   @id @default(uuid())
  tenantId               String   @unique
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moneda                 String   @default("DOP")
  timezone               String   @default("America/Santo_Domingo")
  emailHabilitado        Boolean  @default(true)
  smsHabilitado          Boolean  @default(false)
  mssqlHabilitado        Boolean  @default(false)
  mssqlHost              String?
  mssqlPort              Int?
  mssqlDatabase          String?
  mssqlUserEncrypted     String?
  mssqlPasswordEncrypted String?
  updatedAt              DateTime @updatedAt

  @@map("tenant_settings")
}

// Parámetros configurables clave/valor con default heredado de .env (ITBIS_GENERAL, PLAZO_PAGO_DIAS, etc.)
model Configuracion {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clave     String
  valor     String
  updatedAt DateTime @updatedAt

  @@unique([tenantId, clave])
  @@map("configuraciones")
}

// Catálogo de módulos activables (clave = código, ej. 'pos', 'nomina',
// 'inmobiliaria') — el set de claves posibles es de código
// (MODULOS_BASE en tenants/modulos-base.ts), sembrado acá igual que
// Permission se siembra desde PERMISOS_BASE.
model Modulo {
  id     String @id @default(uuid())
  clave  String @unique
  nombre String

  planes    PlanModulo[]
  overrides TenantModuloOverride[]

  @@map("modulos")
}

// Catálogo de planes comerciales (Básico/Profesional/Premium...) — cada
// uno con un set fijo de módulos incluidos (PlanModulo). Ver
// ModuloActivoGuard para cómo se combina con TenantModuloOverride.
model Plan {
  id               String           @id @default(uuid())
  nombre           String           @unique
  descripcion      String?
  precio           Decimal          @default(0) @db.Decimal(12, 2)
  cicloFacturacion CicloFacturacion @default(MENSUAL)
  createdAt        DateTime         @default(now())

  modulos       PlanModulo[]
  tenants       Tenant[]
  suscripciones Suscripcion[]

  @@map("planes")
}

// El descuento (si aplica) se registra en la Factura de plataforma
// (ver Suscripcion/FacturaPlataforma abajo), nunca acá — el precio del
// Plan es el precio de lista.
enum CicloFacturacion {
  MENSUAL
  ANUAL
}

model PlanModulo {
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  moduloId String
  modulo   Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@id([planId, moduloId])
  @@map("plan_modulos")
}

// Excepción puntual de plataforma sobre lo que dice el plan del tenant:
// activo:true fuerza encendido aunque el plan no incluya ese módulo
// (upsell de un módulo suelto sin cambiar de plan); activo:false fuerza
// apagado aunque el plan sí lo incluya.
model TenantModuloOverride {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduloId  String
  modulo    Modulo   @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  activo    Boolean
  createdAt DateTime @default(now())

  @@unique([tenantId, moduloId])
  @@map("tenant_modulo_overrides")
}

// ============================================================
// SUSCRIPCIÓN Y FACTURACIÓN DE PLATAFORMA (lo que le cobra la
// plataforma a cada tenant por el servicio — no confundir con Factura,
// que es lo que un tenant le cobra a SUS clientes). Deliberadamente
// fuera de TENANT_SCOPED_MODELS/RLS, igual que Modulo/Plan/PlanModulo:
// solo se accede desde controllers de plataforma vía PrismaService raw.
// ============================================================

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
}

// Una por tenant (tenantId único) — el "contrato" de facturación
// recurrente. Cancelarla (estado: CANCELADA) pausa la generación
// automática de facturas sin tocar Tenant.estado (son ejes
// independientes: un tenant puede seguir ACTIVO para sus usuarios
// mientras se resuelve algo de facturación a mano).
model Suscripcion {
  id                String            @id @default(uuid())
  tenantId          String            @unique
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId            String
  plan              Plan              @relation(fields: [planId], references: [id])
  estado            EstadoSuscripcion @default(ACTIVA)
  fechaInicio       DateTime          @default(now())
  fechaProximoCorte DateTime
  // % de mora aplicado una sola vez cuando una factura pasa a VENCIDA.
  feeMoraPct        Decimal           @default(5) @db.Decimal(5, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  facturas FacturaPlataforma[]

  @@map("suscripciones")
}

enum EstadoFacturaPlataforma {
  PENDIENTE
  PAGADA
  VENCIDA
  ANULADA
}

model FacturaPlataforma {
  id               String                  @id @default(uuid())
  tenantId         String
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  suscripcionId    String
  suscripcion      Suscripcion             @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  concepto         String
  monto            Decimal                 @db.Decimal(14, 2)
  descuento        Decimal                 @default(0) @db.Decimal(14, 2)
  montoMora        Decimal                 @default(0) @db.Decimal(14, 2)
  total            Decimal                 @db.Decimal(14, 2)
  moneda           String                  @default("DOP")
  estado           EstadoFacturaPlataforma @default(PENDIENTE)
  fechaEmision     DateTime                @default(now())
  fechaVencimiento DateTime
  fechaPago        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  pagos  PagoPlataforma[]
  lineas FacturaPlataformaLinea[]
  notificacionesVencimientoEnviadas NotificacionVencimientoEnviada[]

  @@map("facturas_plataforma")
}

// Desglose opcional de una FacturaPlataforma: vacío en las generadas
// automáticamente por el ciclo de suscripción (que siguen usando solo
// concepto/monto/total como agregado); solo lo llenan las facturas
// manuales creadas con líneas múltiples (ver FacturasPlataformaService.crearManual).
model FacturaPlataformaLinea {
  id                  String            @id @default(uuid())
  facturaPlataformaId String
  facturaPlataforma   FacturaPlataforma @relation(fields: [facturaPlataformaId], references: [id], onDelete: Cascade)
  concepto            String
  monto               Decimal           @db.Decimal(14, 2)
  // Sin esto el orden no está garantizado: los inserts corren en la
  // misma transacción del nested-create y comparten el mismo now().
  orden               Int               @default(0)
  createdAt           DateTime          @default(now())

  @@map("facturas_plataforma_lineas")
}

// Reutiliza el enum MetodoPago (ver más abajo, ya usado por Pago de
// tenant) — mismo concepto, no vale la pena duplicarlo.
model PagoPlataforma {
  id              String            @id @default(uuid())
  facturaId       String
  factura         FacturaPlataforma @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  monto           Decimal           @db.Decimal(14, 2)
  metodoPago      MetodoPago
  referencia      String?
  fecha           DateTime          @default(now())
  // Nullable + SetNull, mismo criterio que PlatformAuditLog.adminId: si se
  // borra el admin que lo registró, el pago (comprobante real) no debe
  // desaparecer ni bloquear el borrado del admin.
  registradoPorId String?
  registradoPor   PlatformAdmin?    @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())

  @@index([facturaId])
  @@map("pagos_plataforma")
}

// Fila única (sin tenantId, catálogo/config global de plataforma — misma
// categoría que Modulo/Plan). Todo nullable a propósito: null = "sin
// override, seguir usando la variable de entorno correspondiente" — ver
// PlataformaConfiguracionService.sincronizarEnv(). Los campos *Cifrado
// se guardan con encriptado.util.ts (AES-256-GCM), nunca en texto plano.
model PlataformaConfiguracion {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // General
  nombreNegocio String?

  // Notificaciones — email (SMTP)
  emailHabilitado     Boolean?
  smtpHost            String?
  smtpPort            Int?
  smtpUser            String?
  smtpPasswordCifrado String?
  smtpFrom            String?

  // Notificaciones — WhatsApp (Twilio)
  twilioAccountSid       String?
  twilioAuthTokenCifrado String?
  twilioWhatsappFrom     String?

  // Pasarela de pago
  pasarelaActiva             String?
  stripeSecretKeyCifrado     String?
  stripeWebhookSecretCifrado String?
  stripeCurrency             String?

  // Webhook de plataforma (n8n u otro receptor) — Fase 4: disparado ahora
  // por las reglas de notificación de vencimiento (ver
  // ReglaNotificacionVencimiento / PlataformaWebhookChannel).
  webhookUrl           String?
  webhookSecretCifrado String?
  webhookActivo        Boolean @default(false)

  // Fase 4 (última) del roadmap de suscripciones — días de mora (factura
  // en VENCIDA sin pago) antes de suspender automáticamente el tenant.
  // Configurable a pedido del usuario (el roadmap original lo fijaba en
  // 10). Ver FacturasPlataformaCronService.suspenderTenantsMorosos.
  diasParaAutoSuspender Int @default(10)

  @@map("plataforma_configuracion")
}

// Fase 4 — reglas de notificación de vencimiento configurables: N reglas,
// cada una "avisar X días antes/después del vencimiento, por este canal".
// Primera tabla de este tipo en el proyecto (antes solo existía un aviso
// fijo por email — ver RecordatoriosService, del lado de tenant). Enum
// propio (no CanalNotificacion, que ya tiene una rama WEBHOOK/IN_APP
// declarada pero nunca implementada en NotificacionesService.enviar) para
// no heredar ese bug latente.
enum CanalNotificacionVencimiento {
  EMAIL
  WEBHOOK
}

model ReglaNotificacionVencimiento {
  id         String                       @id @default(uuid())
  // Negativo = aviso ANTES del vencimiento; positivo = después (mora).
  offsetDias Int
  canal      CanalNotificacionVencimiento
  activa     Boolean                      @default(true)
  createdAt  DateTime                     @default(now())

  notificacionesEnviadas NotificacionVencimientoEnviada[]

  @@map("reglas_notificacion_vencimiento")
}

// Idempotencia — sin esto, si el cron corre dos veces el mismo día (o se
// reinicia el proceso a mitad de la corrida) se reenviaría el mismo aviso.
model NotificacionVencimientoEnviada {
  id                  String                       @id @default(uuid())
  facturaPlataformaId String
  facturaPlataforma   FacturaPlataforma            @relation(fields: [facturaPlataformaId], references: [id], onDelete: Cascade)
  reglaId             String
  regla               ReglaNotificacionVencimiento @relation(fields: [reglaId], references: [id], onDelete: Cascade)
  fecha               DateTime                     @default(now())

  @@unique([facturaPlataformaId, reglaId])
  @@map("notificaciones_vencimiento_enviadas")
}

// ============================================================
// CORE: USUARIOS, ROLES, PERMISOS, AUDITORÍA
// ============================================================

model User {
  id                     String    @id @default(uuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                  String
  passwordHash           String
  nombre                 String
  activo                 Boolean   @default(true)
  resetPasswordTokenHash String?
  resetPasswordExpiraEn  DateTime?
  /// PIN corto (4-6 dígitos) de confirmación para acciones sensibles
  /// (Fase 9 de adopción de Cuadre) — NO reemplaza ningún permiso RBAC,
  /// es una capa extra. Nullable/autoservicio: sin PIN configurado, las
  /// acciones gateadas siguen funcionando igual que hoy (default
  /// permisivo, mismo criterio que sucursales sin asignar).
  pinHash                String?
  pinIntentosFallidos    Int       @default(0)
  pinBloqueadoHasta      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  roles                          UserRole[]
  auditLogs                      AuditLog[]
  facturasVendedor               Factura[]              @relation("FacturaVendedor")
  movimientosInventario          MovimientoInventario[]
  ordenesCompra                  OrdenCompra[]
  ajustesInventario              AjusteInventario[]
  transferenciasInventario       TransferenciaInventario[]
  cotizaciones                   Cotizacion[]
  remisiones                     Remision[]
  turnosCaja                     TurnoCaja[]
  turnosCajaCerrados             TurnoCaja[]            @relation("TurnoCajaCerradoPor")
  turnosCajaRevisados            TurnoCaja[]            @relation("TurnoCajaRevisadoPor")
  pagos                          Pago[]
  // Nullable: no todo User de sistema tiene un Empleado de nómina asociado
  // (ej. un Admin Total que no está en planilla).
  empleado                       Empleado?
  ausenciasSolicitadas           Ausencia[]             @relation("AusenciaSolicitadaPor")
  ausenciasAprobadas             Ausencia[]             @relation("AusenciaAprobadaPor")
  asistenciasAprobadas           RegistroAsistencia[]   @relation("AsistenciaAprobadaPor")
  sucursales                     UsuarioSucursal[]
  codigosAutorizacionSolicitados CodigoAutorizacion[]

  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  esSistema   Boolean @default(false)

  permisos        UserRole[]       @relation("RoleUserRole")
  rolePermissions RolePermission[]

  @@unique([tenantId, nombre])
  @@map("roles")
}

// Catálogo global de permisos, ej: "facturacion.crear", "inventario.ajustar"
model Permission {
  id          String  @id @default(uuid())
  clave       String  @unique
  descripcion String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation("RoleUserRole", fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accion    String
  entidad   String
  entidadId String?
  antes     Json?
  despues   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, entidad, entidadId])
  @@map("audit_logs")
}

/// Bitácora de acciones del super admin de plataforma (crear/suspender
/// tenants, etc.) — separada de AuditLog porque no tiene tenantId.
model PlatformAuditLog {
  id        String         @id @default(uuid())
  adminId   String?
  admin     PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  accion    String
  entidad   String
  entidadId String?
  despues   Json?
  ip        String?
  createdAt DateTime       @default(now())

  @@index([entidad, entidadId])
  @@map("platform_audit_logs")
}

// ============================================================
// FACTURACIÓN
// ============================================================

enum TipoNcf {
  B01 // Crédito Fiscal
  B02 // Consumo
  B14 // Régimen Especial
  B15 // Gubernamental
  B04 // Nota de Crédito
  B03 // Nota de Débito
  // e-CF (comprobantes electrónicos DGII) — mismo ambiente de NcfAsignado/
  // siguienteNcfEnTx que B0x, solo cambia el prefijo. Ver ARCHITECTURE.md:
  // ambiente de numeración propio; firma digital y envío a la DGII (o a un
  // proveedor certificado de e-CF) quedan fuera de esta fase a propósito.
  E31 // Crédito Fiscal Electrónico
  E32 // Consumo Electrónico
  E34 // Nota de Crédito Electrónica
  E33 // Nota de Débito Electrónica
  B11 // Comprobante de Compras (mercado informal) — ver GastoMenor
  E43 // Gastos Menores Electrónico
  // Equivalentes electrónicos de B14/B15 (plan de integración Cuadre,
  // ítem B-1) — ver TIPO_NCF_ESPECIAL en facturacion.service.ts: hasta
  // ahora B14/B15 estaban en el enum pero ningún flujo real los podía
  // seleccionar (el NCF se derivaba siempre de tipoFactura, sin que el
  // usuario elija el tipo de comprobante).
  E44 // Régimen Especial Electrónico
  E45 // Gubernamental Electrónico
}

// Decide, por tenant, si Facturación pide NCF tradicional (B0x) o e-CF (E3x)
// para el mismo tipoFactura — ver FacturacionService.crear (NCF_POR_TIPO/ECF_POR_TIPO).
enum ModalidadFacturacion {
  NCF
  ECF
}

enum TipoFactura {
  CONTADO
  CREDITO
  NOTA_DEBITO
  NOTA_CREDITO
}

enum EstadoFactura {
  BORRADOR
  EMITIDA
  ANULADA
}

/// `sucursalId` nullable (plan de integración Cuadre, ítem B-2) = secuencia
/// COMPARTIDA por todas las sucursales (comportamiento histórico, default
/// para un tenant sin sucursales configuradas o que no necesita separar).
/// Con sucursales, se puede crear una fila adicional con `sucursalId` fijo
/// para que esa sucursal emita desde su propio rango — `NcfRepository.
/// siguienteNcfEnTx` intenta la fila específica de la sucursal primero y
/// cae a la compartida (`sucursalId: null`) si no existe. A lo sumo UNA
/// fila compartida por tipo (`@@unique` no lo cubre porque Postgres no
/// deduplica NULLs — se valida en `NcfService.crear`, mismo criterio de
/// invariante en código que `PlantillaHorario.predeterminada`).
/// `umbralAlerta` (nullable = sin alerta) dispara `EVENTOS.NCF_POR_AGOTARSE`
/// cuando los comprobantes restantes caen a ese nivel o menos.
enum TipoCorrelativo {
  COTIZACION
  REMISION
  ORDEN_COMPRA
  CAJA
  PRODUCTO
  CUENTA_CONTABLE
  // Número interno de Factura (distinto del NCF, que es el comprobante
  // fiscal) — brecha real encontrada al comparar contra Cuadre, que
  // muestra ambos por separado. Agregado después de K-1 (que dejó
  // Factura afuera a propósito, por ya tener NCF).
  FACTURA
  // Ítem E-1 — Ajustes/Transferencias de inventario ganan su propio
  // documento con número (antes eran solo un movimiento instantáneo sin
  // cabecera, ver AjusteInventario/TransferenciaInventario).
  AJUSTE
  TRANSFERENCIA
}

/// Correlativo automático genérico (plan de integración Cuadre, ítem de
/// "consecutivos" — ver ARCHITECTURE.md) — mismo patrón atómico que
/// NcfAsignado.secuenciaActual (`{ increment: 1 }`, ver
/// CorrelativosRepository.siguienteEnTx), reusado para varios tipos de
/// documento en vez de un contador por tabla. `siguienteNumero` apunta al
/// PRÓXIMO a asignar (no al último usado) — mismo criterio que
/// NcfAsignado.secuenciaActual. COTIZACION/REMISION/ORDEN_COMPRA/CAJA se
/// consumen automáticamente al crear (sin edición manual en el
/// formulario); PRODUCTO/CUENTA_CONTABLE se consumen solo bajo demanda
/// (botón "Asignar"), el campo sigue aceptando texto libre.
model Correlativo {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo            TipoCorrelativo
  prefijo         String          @default("")
  siguienteNumero Int             @default(1)
  digitos         Int             @default(5)

  @@unique([tenantId, tipo])
  @@map("correlativos")
}

/// Configuración de WhatsApp por tenant (plan de integración Cuadre,
/// ítem H-2a, extendida en H-2b con el bot conversacional real —
/// ver ARCHITECTURE.md). `WhatsAppChannel.enviar()` (notificaciones
/// salientes existentes, nivel plataforma) sigue sin tocarse — el bot
/// usa sus propias credenciales tenant-scoped vía
/// `enviarWhatsappTwilio()` (`common/utils/twilio-whatsapp.util.ts`).
model WhatsappConfigTenant {
  id                      String   @id @default(uuid())
  tenantId                String   @unique
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  habilitado              Boolean  @default(false)
  twilioAccountSid        String?
  twilioAuthTokenCifrado  String?
  // @unique: es la clave para resolver a qué tenant pertenece un
  // webhook entrante de Twilio (ver WhatsappWebhookController) — antes
  // de H-2b no tenía índice porque nadie lo consultaba por valor.
  twilioWhatsappFrom      String?  @unique
  iaProveedor             String?
  iaModelo                String?
  iaApiKeyCifrado         String?
  historialMensajes       Int      @default(10)
  // Texto libre del tenant (horario, dirección, tono) — se antepone al
  // scaffolding fijo del prompt de sistema (JSON de respuesta +
  // guardrail de no inventar datos reales), nunca lo reemplaza — ver
  // WhatsappBotService.
  iaPromptNegocio         String?
  // Tope de respuestas de IA por día calendario de RD (WhatsappMensaje.diaRD)
  // — al llegar acá, se responde un mensaje fijo sin llamar a la IA.
  limiteRespuestasDiarias Int      @default(50)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("whatsapp_config_tenant")
}

/// Historial de conversación del bot de WhatsApp (ítem H-2b) — usa
/// `PrismaService` global (no `TenantPrismaService`) porque lo escribe
/// un webhook público sin JWT, mismo criterio que `SesionCobroFactura`
/// (ítem C-1). `diaRD` (no un rango de fechas) para el tope diario sin
/// aritmética de husos horarios — ver `fechaHoyRD()`.
model WhatsappMensaje {
  id                     String   @id @default(uuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  telefono               String // remitente tal cual lo manda Twilio (whatsapp:+...)
  rol                    String // 'USUARIO' | 'ASISTENTE' | 'HUMANO' (staff respondiendo desde la bandeja)
  contenido              String
  requiereAtencionHumana Boolean  @default(false)
  atendido               Boolean  @default(false)
  diaRD                  String
  createdAt              DateTime @default(now())

  @@index([tenantId, telefono, createdAt])
  @@index([tenantId, diaRD])
  @@index([tenantId, requiereAtencionHumana, atendido])
  @@map("whatsapp_mensajes")
}

/// Credenciales de AZUL/CardNet por tenant (ítem C-1, Payment Link — ver
/// ARCHITECTURE.md) — mismo molde de 4 capas que WhatsappConfigTenant
/// (obtenerOCrear/aplicarCampoSecreto/aFormaSegura). `pasarelaActiva`
/// decide cuál de los dos procesa el checkout público; ambos bloques de
/// campos conviven en una sola fila (mismo criterio que
/// PlataformaConfiguracion, que junta SMTP/Twilio/Stripe en una fila
/// única) en vez de dos tablas separadas.
model PasarelaConfigTenant {
  id             String  @id @default(uuid())
  tenantId       String  @unique
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pasarelaActiva String? // 'AZUL' | 'CARDNET' | null

  // Página de Pagos AZUL usa una sola AuthKey entregada al afiliarse (no
  // Auth1/Auth2 — esos campos son de su API SOAP de Webservices, que no
  // es la que se implementa acá). CurrencyCode también lo asigna AZUL
  // por comercio (no es un código ISO 4217 genérico) — ver
  // ARCHITECTURE.md/PDF oficial "Página de Pagos".
  azulMerchantId     String?
  azulMerchantName   String?
  azulCurrencyCode   String? @default("$")
  azulAuthKeyCifrado String?

  // "Botón de Pago — Web con Pantalla" de CardNet NO usa clave de firma —
  // autentica con TLS 1.2 + el par MerchantNumber/MerchantTerminal
  // (asignados por CardNet al afiliarse), sin header de autorización ni
  // HMAC — confirmado contra developers.cardnet.com.do (a diferencia de
  // AZUL, que sí firma con AuthHash). MerchantType (código de categoría
  // de comercio) y AcquiringInstitutionCode también los asigna CardNet
  // por comercio, no son constantes genéricas.
  cardnetMerchantNumber           String?
  cardnetMerchantTerminal         String?
  cardnetMerchantTerminalAmex     String?
  cardnetMerchantName             String?
  cardnetMerchantType             String?
  cardnetAcquiringInstitutionCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pasarela_config_tenant")
}

/// Ledger de intentos de cobro por pasarela (ítem C-1) — dos propósitos:
/// (1) idempotencia real, dedup explícito por (pasarela, referenciaExterna)
/// ANTES de registrar el Pago — a propósito no se replica el atajo de
/// PagoPlataforma ("si la factura ya está pagada, no hagas nada"), que
/// deja de ser seguro en cuanto se permiten pagos parciales (este ítem sí
/// los permite); (2) guarda el `sk` de CardNet entre crear la sesión y
/// verificar el retorno — CardNet no empuja webhook, hay que re-consultar
/// con esa clave.
model SesionCobroFactura {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facturaId         String
  pasarela          String // 'AZUL' | 'CARDNET'
  referenciaExterna String // OrderNumber (Azul) o session id (CardNet)
  monto             Decimal  @db.Decimal(14, 2)
  datosVerificacion String? // ej. sk de CardNet, cifrado — null para Azul
  estado            String   @default("PENDIENTE") // PENDIENTE | CONFIRMADO | RECHAZADO
  pagoId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([pasarela, referenciaExterna])
  @@index([facturaId])
  @@map("sesiones_cobro_factura")
}

model NcfAsignado {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoNcf         TipoNcf
  sucursalId      String?
  sucursal        Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  secuenciaActual Int
  secuenciaFinal  Int
  vigenciaHasta   DateTime
  umbralAlerta    Int?
  activo          Boolean   @default(true)

  @@unique([tenantId, tipoNcf, sucursalId])
  @@map("ncf_asignados")
}

model Factura {
  id                 String        @id @default(uuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId          String
  cliente            Cliente       @relation(fields: [clienteId], references: [id])
  vendedorId         String
  vendedor           User          @relation("FacturaVendedor", fields: [vendedorId], references: [id])
  // Nullable porque las facturas creadas antes de esta columna no lo tienen;
  // sin esto no hay forma de saber a qué bodega devolver stock al anular.
  bodegaId           String?
  bodega             Bodega?       @relation(fields: [bodegaId], references: [id])
  // Número interno de empresa, distinto del NCF (comprobante fiscal) —
  // ver TipoCorrelativo.FACTURA. Nullable: las facturas creadas antes
  // de esta columna no lo tienen (mismo criterio que bodegaId arriba),
  // se completan mediante el script de backfill si se corre.
  numero             String?
  ncf                String?
  tipoNcf            TipoNcf?
  tipoFactura        TipoFactura
  estado             EstadoFactura @default(BORRADOR)
  motivoAnulacion    String?
  motivoNota         String?
  fecha              DateTime      @default(now())
  subtotal           Decimal       @db.Decimal(14, 2)
  descuento          Decimal       @default(0) @db.Decimal(14, 2)
  itbis              Decimal       @db.Decimal(14, 2)
  total              Decimal       @db.Decimal(14, 2)
  // Ítem C-2 (multi-moneda) — `subtotal`/`itbis`/`total` de arriba SIGUEN
  // siendo siempre DOP (nunca cambian de significado, cero riesgo para
  // NCF/contabilidad/reportes/pagos, que ya los leen así). `moneda`
  // (default "DOP") + `tasaCambio` (snapshot al momento de la venta,
  // null si moneda=DOP) + `subtotalMoneda`/`itbisMoneda`/`totalMoneda`
  // (equivalente en esa moneda, solo para mostrar al cliente en el
  // documento impreso) son PURAMENTE de presentación — ver
  // ARCHITECTURE.md.
  moneda             String        @default("DOP")
  tasaCambio         Decimal?      @db.Decimal(14, 6)
  subtotalMoneda     Decimal?      @db.Decimal(14, 2)
  itbisMoneda        Decimal?      @db.Decimal(14, 2)
  totalMoneda        Decimal?      @db.Decimal(14, 2)
  plazoPagoDias      Int           @default(30)
  pagada             Boolean       @default(false)
  fechaPago          DateTime?
  facturaOrigenId    String?
  facturaOrigen      Factura?      @relation("FacturaOrigenNota", fields: [facturaOrigenId], references: [id])
  notasRelacionadas  Factura[]     @relation("FacturaOrigenNota")
  // Solo lo llenan las ventas de POS (ver PosService.registrarVenta) — el resto de
  // flujos de facturación (venta normal, conversión de cotización/remisión) los deja null.
  // FormaPago (catálogo configurable por tenant, ver formas-pago/) reemplazó al enum
  // MetodoPago acá — ese enum sigue existiendo solo para PagoPlataforma (plataforma).
  formaPagoId        String?
  formaPago          FormaPago?    @relation(fields: [formaPagoId], references: [id])
  // Solo aplica si formaPago.requiereReferencia — nro. de cheque, confirmación de
  // transferencia, etc. Sin relación con `ncf`.
  referenciaPago     String?
  turnoCajaId        String?
  // SetNull (no Cascade): si el turno se borra, la factura (documento fiscal) debe
  // sobrevivir siempre — solo se pierde el vínculo con el turno de caja.
  turnoCaja          TurnoCaja?    @relation(fields: [turnoCajaId], references: [id], onDelete: SetNull)
  // Empleado (cargo "Vendedor" en Nómina) acreditado por comisión en la venta —
  // distinto de `vendedorId` (User, quien la registra/cobra). Solo lo llenan
  // ventas de POS que eligen un vendedor (F2) — ver PosService.registrarVenta.
  vendedorEmpleadoId String?
  vendedorEmpleado   Empleado?     @relation(fields: [vendedorEmpleadoId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  lineas             LineaFactura[]
  recargos           FacturaRecargo[]
  cotizacionOrigen   Cotizacion?
  remisionOrigen     Remision?
  pagos              Pago[]
  pagosVenta         PagoVenta[]
  comisiones         ComisionVenta[]
  movimientosLealtad MovimientoLealtad[]

  @@unique([tenantId, ncf])
  @@unique([tenantId, numero])
  @@index([tenantId, clienteId])
  @@map("facturas")
}

// Ítem B-4 — cargos post-subtotal (Imprevistos, Viáticos, etc.), fuera de
// la lista de líneas de producto. Mismo patrón que FacturaPlataformaLinea
// (tabla hija simple, sin catálogo reusable aparte — un recargo es texto
// libre por factura, no una entidad de configuración): menos superficie
// que inventar un catálogo `RecargoFactura` nuevo.
model FacturaRecargo {
  id        String  @id @default(uuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  concepto  String
  monto     Decimal @db.Decimal(14, 2)
  // Si aplica ITBIS sobre el monto del recargo (tasa general del tenant,
  // igual que una línea manual — ver ítem B-9) o no (ej. "Anticipo").
  gravado   Boolean @default(false)
  // Mismo motivo que FacturaPlataformaLinea.orden: los inserts corren en
  // la misma transacción del nested-create y comparten el mismo now().
  orden     Int     @default(0)

  @@map("factura_recargos")
}

model LineaFactura {
  id                String            @id @default(uuid())
  facturaId         String
  factura           Factura           @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  // Nullable (ítem B-9, plan de integración Cuadre) — null junto con
  // `descripcionManual` no-null es una línea libre sin producto del
  // catálogo (invariante validada en FacturacionService, no con un CHECK
  // de Postgres). Con productoId, comportamiento intacto.
  productoId        String?
  producto          Producto?         @relation(fields: [productoId], references: [id])
  // Fase 3c, incremento 3: la variante realmente vendida — necesaria para
  // que anular() reintegre stock a la MISMA variante, no a "la que sea".
  // Restrict (no Cascade): perder esto sería perder a qué variante
  // corresponde una línea fiscal ya emitida. Nullable junto con
  // productoId (ítem B-9) — una línea manual no tiene variante.
  varianteId        String?
  variante          VarianteProducto? @relation(fields: [varianteId], references: [id])
  // Ítem B-9 — texto libre cuando productoId es null (línea sin producto
  // del catálogo, ej. "Instalación", "Servicio no catalogado").
  descripcionManual String?
  cantidad          Decimal           @db.Decimal(14, 4)
  precioUnitario    Decimal           @db.Decimal(14, 4)
  porcentajeItbis   Decimal           @db.Decimal(5, 2)
  descuento         Decimal           @default(0) @db.Decimal(14, 2)
  montoItbis        Decimal           @db.Decimal(14, 2)
  montoTotal        Decimal           @db.Decimal(14, 2)
  // Ítem A-1 — false solo cuando el descuento automático de esta línea
  // vino de una Oferta con `pagaComision: false` (decisión "todo o nada":
  // si alguna oferta ganadora no paga comisión, la línea entera no genera
  // comisión). true por default: sin oferta, o con descuento manual, la
  // línea sí genera comisión normalmente. Ver
  // OfertasService.resolverDescuentoLineaConComision.
  pagaComision      Boolean           @default(true)

  @@map("linea_factura")
}

// ============================================================
// COTIZACIONES Y REMISIONES
// Documentos sin efecto fiscal que preceden a una factura.
// ============================================================

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

model Cotizacion {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId          String
  cliente            Cliente          @relation(fields: [clienteId], references: [id])
  vendedorId         String
  vendedor           User             @relation(fields: [vendedorId], references: [id])
  numero             String
  estado             EstadoCotizacion @default(BORRADOR)
  fechaVigenciaHasta DateTime
  subtotal           Decimal          @db.Decimal(14, 2)
  descuento          Decimal          @default(0) @db.Decimal(14, 2)
  itbis              Decimal          @db.Decimal(14, 2)
  total              Decimal          @db.Decimal(14, 2)
  // Se completa al convertirla en factura; a partir de ahí es de solo lectura.
  facturaId          String?          @unique
  factura            Factura?         @relation(fields: [facturaId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  lineas LineaCotizacion[]

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@map("cotizaciones")
}

model LineaCotizacion {
  id                String            @id @default(uuid())
  cotizacionId      String
  cotizacion        Cotizacion        @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  // Nullable (ítem B-9) — ver el comentario equivalente en
  // LineaFactura.productoId.
  productoId        String?
  // Cascade (a diferencia de LineaFactura, que preserva historial fiscal):
  // una cotización no es un documento fiscal, y sin esto un borrado en
  // cascada del tenant puede fallar por una carrera en el orden en que
  // Postgres resuelve las cascadas de "productos" vs. "cotizaciones".
  producto          Producto?         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  // Ver el comentario equivalente en LineaFactura.varianteId — se propaga
  // sin cambios al convertir la cotización en factura. Nullable junto con
  // productoId (ítem B-9).
  varianteId        String?
  variante          VarianteProducto? @relation(fields: [varianteId], references: [id])
  // Ítem B-9 — ver el comentario equivalente en LineaFactura.
  descripcionManual String?
  cantidad          Decimal           @db.Decimal(14, 4)
  precioUnitario    Decimal           @db.Decimal(14, 4)
  porcentajeItbis   Decimal           @db.Decimal(5, 2)
  descuento         Decimal           @default(0) @db.Decimal(14, 2)
  montoItbis        Decimal           @db.Decimal(14, 2)
  montoTotal        Decimal           @db.Decimal(14, 2)

  @@map("linea_cotizacion")
}

enum EstadoRemision {
  BORRADOR
  ENTREGADA
  FACTURADA
  ANULADA
}

/// "Remisión + stock" (2026-08-26): BORRADOR -> ENTREGADA descuenta
/// inventario de verdad (RemisionesService.cambiarEstado, mismas
/// primitivas de InventarioService que FacturacionService.crear() —
/// verificarYDescontarStockEnTx/entradaStockEnTx) — una remisión
/// entregada representa mercancía que YA salió físicamente, no solo al
/// convertirla en factura. ENTREGADA -> ANULADA reintegra ese stock;
/// BORRADOR -> ANULADA nunca lo movió. Al convertir, FacturacionService.
/// crear() recibe sinMovimientoInventario:true si ya pasó por ENTREGADA
/// (evita descontar dos veces) — convertir directo desde BORRADOR sigue
/// descontando en crear(), como siempre.
model Remision {
  id         String         @id @default(uuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero     String
  clienteId  String
  cliente    Cliente        @relation(fields: [clienteId], references: [id])
  bodegaId   String
  bodega     Bodega         @relation(fields: [bodegaId], references: [id])
  vendedorId String
  vendedor   User           @relation(fields: [vendedorId], references: [id])
  estado     EstadoRemision @default(BORRADOR)
  fecha      DateTime       @default(now())
  facturaId  String?        @unique
  factura    Factura?       @relation(fields: [facturaId], references: [id])
  createdAt  DateTime       @default(now())

  lineas LineaRemision[]

  @@unique([tenantId, numero])
  @@map("remisiones")
}

model LineaRemision {
  id         String           @id @default(uuid())
  remisionId String
  remision   Remision         @relation(fields: [remisionId], references: [id], onDelete: Cascade)
  productoId String
  // Ver comentario equivalente en LineaCotizacion.producto.
  producto   Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  // Ver el comentario equivalente en LineaFactura.varianteId.
  varianteId String
  variante   VarianteProducto @relation(fields: [varianteId], references: [id])
  cantidad   Decimal          @db.Decimal(14, 4)

  @@map("linea_remision")
}

// ============================================================
// CONTABILIDAD (partida doble)
// ============================================================

enum TipoCuentaContable {
  ACTIVO
  PASIVO
  PATRIMONIO
  INGRESO
  GASTO
}

/// Determina si un débito o un crédito AUMENTA el saldo de la cuenta.
/// ACTIVO/GASTO son deudoras (débito aumenta); PASIVO/PATRIMONIO/INGRESO
/// son acreedoras (crédito aumenta). Se guarda explícito en vez de
/// derivarlo del tipo en cada cálculo, para permitir la excepción rara
/// (cuentas contra-activo, etc.) sin tener que tocar la lógica de saldo.
enum NaturalezaCuenta {
  DEUDORA
  ACREEDORA
}

model CuentaContable {
  id            String             @id @default(uuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codigo        String
  nombre        String
  tipo          TipoCuentaContable
  naturaleza    NaturalezaCuenta
  cuentaPadreId String?
  cuentaPadre   CuentaContable?    @relation("JerarquiaCuenta", fields: [cuentaPadreId], references: [id])
  subcuentas    CuentaContable[]   @relation("JerarquiaCuenta")
  activa        Boolean            @default(true)
  createdAt     DateTime           @default(now())

  lineasAsiento    LineaAsiento[]
  cuentasBancarias CuentaBancaria[]
  lineasGastoMenor LineaGastoMenor[]

  @@unique([tenantId, codigo])
  @@map("cuentas_contables")
}

enum OrigenAsiento {
  FACTURA
  COMPRA
  MANUAL
  NOMINA
  PAGO
  GASTO
  GASTO_MENOR
  CIERRE
  ANULACION
}

enum TipoCuentaBancaria {
  CORRIENTE
  AHORROS
}

model CuentaBancaria {
  id               String             @id @default(uuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  banco            String
  numeroCuenta     String
  tipoCuenta       TipoCuentaBancaria
  // A qué cuenta del catálogo contable representa (tipo ACTIVO, ej. "Caja
  // y Bancos") — el saldo real vive en el libro mayor de ESA cuenta, no
  // acá; CuentaBancaria es solo una capa de UX para elegir "de qué banco
  // sale el dinero" en vez de un código de cuenta contable crudo. Sin
  // saldo propio ni conciliación — eso sigue fuera de alcance.
  // Cascade (no la falta por defecto de Postgres/Prisma): CuentaContable y
  // CuentaBancaria son ramas hermanas desde Tenant (Tenant -> CuentaContable
  // vs Tenant -> CuentaBancaria) que compiten al borrar un tenant completo
  // — mismo patrón ya documentado en DATABASE.md para turnos_caja/
  // recibos_nomina. Sin esto, borrar el tenant falla con FK violation si
  // alguna CuentaBancaria todavía referencia la CuentaContable que se
  // intenta borrar en esa misma cascada.
  cuentaContableId String
  cuentaContable   CuentaContable     @relation(fields: [cuentaContableId], references: [id], onDelete: Cascade)
  activa           Boolean            @default(true)
  createdAt        DateTime           @default(now())

  gastosMenores GastoMenor[]

  @@unique([tenantId, numeroCuenta])
  @@map("cuentas_bancarias")
}

model GastoMenor {
  id               String         @id @default(uuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // NCF tipo B11 (Comprobante de Compras — norma DGII para compras a
  // proveedores informales sin su propio NCF) o E43 si el tenant está en
  // modalidad e-CF (ver ModalidadFacturacion). Mismo NcfAsignado/
  // siguienteNcf ya usado por Facturación.
  ncf              String?
  tipoNcf          TipoNcf?
  notas            String?
  fecha            DateTime       @default(now())
  // Cascade — misma razón que CuentaBancaria.cuentaContable arriba (ramas
  // hermanas desde Tenant que compiten al borrarlo completo).
  cuentaBancariaId String
  cuentaBancaria   CuentaBancaria @relation(fields: [cuentaBancariaId], references: [id], onDelete: Cascade)
  monto            Decimal        @db.Decimal(14, 2)
  itbis            Decimal        @db.Decimal(14, 2)
  total            Decimal        @db.Decimal(14, 2)
  createdAt        DateTime       @default(now())

  lineas LineaGastoMenor[]

  @@unique([tenantId, ncf])
  @@map("gastos_menores")
}

// Tabla hija sin tenantId propio (mismo patrón que LineaFactura/LineaAsiento
// — ver DATABASE.md): su aislamiento depende de llegar siempre vía un
// GastoMenor ya resuelto contra el tenant.
model LineaGastoMenor {
  id               String         @id @default(uuid())
  gastoMenorId     String
  gastoMenor       GastoMenor     @relation(fields: [gastoMenorId], references: [id], onDelete: Cascade)
  // Cascade — misma razón que las de arriba (rama hermana desde Tenant vía
  // GastoMenor -> LineaGastoMenor compitiendo con Tenant -> CuentaContable).
  cuentaContableId String
  cuentaContable   CuentaContable @relation(fields: [cuentaContableId], references: [id], onDelete: Cascade)
  concepto         String?
  valor            Decimal        @db.Decimal(14, 2)
  porcentajeItbis  Decimal        @default(0) @db.Decimal(5, 2)
  montoItbis       Decimal        @db.Decimal(14, 2)
  cantidad         Decimal        @default(1) @db.Decimal(14, 4)
  montoTotal       Decimal        @db.Decimal(14, 2)

  @@map("lineas_gasto_menor")
}

model AsientoContable {
  id        String        @id @default(uuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero    Int
  fecha     DateTime      @default(now())
  concepto  String
  origen    OrigenAsiento
  origenId  String?
  anulado   Boolean       @default(false)
  createdAt DateTime      @default(now())

  lineas         LineaAsiento[]
  periodoCerrado PeriodoContableCerrado?

  @@unique([tenantId, numero])
  @@map("asientos_contables")
}

/// Un registro por período contable ya cerrado (ver CierrePeriodoService).
/// `fecha` es la fecha de corte; el cierre siguiente debe ser posterior a
/// ella. `asientoCierre` es el asiento automático (origen CIERRE) que
/// traspasa el saldo neto de INGRESO/GASTO del período a Utilidades
/// Retenidas — ver el comentario en estados-financieros.service.ts sobre
/// por qué esto hacía falta.
model PeriodoContableCerrado {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fecha           DateTime
  utilidadNeta    Decimal         @db.Decimal(14, 2)
  asientoCierreId String          @unique
  asientoCierre   AsientoContable @relation(fields: [asientoCierreId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())

  @@unique([tenantId, fecha])
  @@map("periodos_contables_cerrados")
}

/// Cada línea es débito O crédito, nunca ambos (uno de los dos queda en
/// 0) — es la representación normal de partida doble. El asiento
/// completo balancea cuando sum(debito) == sum(credito) entre todas sus
/// líneas; esa invariante se valida en AsientosContablesService, nunca
/// a nivel de fila.
model LineaAsiento {
  id               String          @id @default(uuid())
  asientoId        String
  asiento          AsientoContable @relation(fields: [asientoId], references: [id], onDelete: Cascade)
  cuentaContableId String
  // Cascade: ver el comentario equivalente en LineaCotizacion.producto —
  // misma carrera de Postgres al borrar un tenant completo (Tenant ->
  // CuentaContable y Tenant -> AsientoContable -> LineaAsiento son ramas
  // hermanas que compiten por borrar primero).
  cuentaContable   CuentaContable  @relation(fields: [cuentaContableId], references: [id], onDelete: Cascade)
  debito           Decimal         @default(0) @db.Decimal(14, 2)
  credito          Decimal         @default(0) @db.Decimal(14, 2)
  descripcion      String?
  // Conciliación bancaria manual (ver EstadosFinancierosService.conciliacionBancaria) —
  // sin importar extractos ni auto-match: el contador marca a mano cada línea
  // que ya confirmó contra el estado de cuenta del banco.
  conciliado       Boolean         @default(false)
  conciliadoEn     DateTime?

  @@map("lineas_asiento")
}

// ============================================================
// NÓMINA
// ============================================================

enum TipoContrato {
  INDEFINIDO
  DETERMINADO
}

enum TipoPeriodoNomina {
  // SEMANAL/BIMENSUAL agregados en el plan de integración de brechas
  // Cuadre, ítem G-7 — ver factorPeriodo en periodos-nomina.service.ts
  // para cómo se prorratea cada uno contra el salario mensual.
  SEMANAL
  QUINCENAL
  BIMENSUAL
  MENSUAL
}

enum EstadoPeriodoNomina {
  BORRADOR
  PROCESADO
  PAGADO
}

model Empleado {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre              String
  cedula              String
  cargo               String
  // Catálogo de puestos estructurado (plan de integración Cuadre, ítem
  // G-8) — puramente aditivo: `cargo` (texto libre) sigue existiendo tal
  // cual y sigue siendo lo que resuelve "Vendedor" en
  // `EmpleadosRepository.listarVendedores` (contains insensitive) — no
  // se toca, para no romper esa búsqueda. `puestoId` es un filtro/
  // clasificación adicional, opcional.
  puestoId            String?
  puesto              Puesto?           @relation(fields: [puestoId], references: [id], onDelete: SetNull)
  // Plantilla de horario reutilizable (plan de integración Cuadre, ítem
  // G-1) — referencia VIVA (decisión explícita del usuario): editar la
  // plantilla se propaga automáticamente a todos los empleados
  // asignados, no es una copia que se independiza al asignarse. Cuando
  // está seteado, TIENE PRIORIDAD sobre `horarios` (HorarioEmpleado
  // individual) al resolver tardanza/horas extra — ver
  // HorariosRepository.resolverDiasEfectivos.
  plantillaHorarioId  String?
  plantillaHorario    PlantillaHorario? @relation(fields: [plantillaHorarioId], references: [id], onDelete: SetNull)
  departamento        String?
  fechaIngreso        DateTime
  fechaSalida         DateTime?
  salarioBrutoMensual Decimal           @db.Decimal(14, 2)
  tipoContrato        TipoContrato      @default(INDEFINIDO)
  activo              Boolean           @default(true)
  email               String?
  telefono            String?
  createdAt           DateTime          @default(now())
  // Nullable + único: no todo empleado necesita login (ej. personal de
  // bodega sin acceso al sistema); habilita el check-in/check-out de
  // autoservicio (RegistroAsistencia) resolviendo req.user.userId -> este
  // campo. onDelete SetNull: borrar el User no debe borrar el historial
  // de nómina del empleado.
  userId              String?           @unique
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  recibos             ReciboNomina[]
  ventasComoVendedor  Factura[]
  ventasAparcadas     VentaAparcada[]
  carritosBorrador    CarritoBorrador[]
  horarios            HorarioEmpleado[]
  registrosAsistencia RegistroAsistencia[]
  ausencias           Ausencia[]
  comisionesVenta     ComisionVenta[]

  @@unique([tenantId, cedula])
  @@map("empleados")
}

/// Plantilla de horario reutilizable (plan de integración Cuadre, ítem
/// G-1) — a diferencia de `HorarioEmpleado` (una fila por empleado por
/// día, asignación directa e individual), esto se define UNA vez y se
/// asigna a varios empleados vía `Empleado.plantillaHorarioId` como
/// REFERENCIA VIVA: editar `dias` acá cambia automáticamente el horario
/// efectivo de todos los empleados asignados. `predeterminada` (a lo
/// sumo una activa por tenant, ver PlantillasHorarioRepository.
/// desmarcarPredeterminadaDeOtras) se auto-asigna a un Empleado nuevo
/// que no reciba `plantillaHorarioId`/`horario` explícito al crearse.
model PlantillaHorario {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre         String
  codigo         String
  descripcion    String?
  predeterminada Boolean  @default(false)
  activa         Boolean  @default(true)
  createdAt      DateTime @default(now())

  dias      PlantillaHorarioDia[]
  empleados Empleado[]

  @@unique([tenantId, codigo])
  @@map("plantillas_horario")
}

/// Fila día-por-día de una PlantillaHorario — misma forma que
/// HorarioEmpleado, sin tenantId propio (hijo sin FK directa a Tenant,
/// como ComponenteCombo/ValorAtributo — su aislamiento depende de
/// validar primero la plantilla padre, ya tenant-scoped).
model PlantillaHorarioDia {
  id          String           @id @default(uuid())
  plantillaId String
  plantilla   PlantillaHorario @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  diaSemana   DiaSemana
  horaEntrada String
  horaSalida  String

  @@unique([plantillaId, diaSemana])
  @@map("plantilla_horario_dias")
}

/// Catálogo de puestos por tenant (plan de integración Cuadre, ítem
/// G-8) — tenant-scoped, plano (sin jerarquía). Ver Empleado.puestoId.
model Puesto {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  empleados Empleado[]

  @@unique([tenantId, nombre])
  @@map("puestos")
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

/// Horario semanal recurrente por empleado (Fase 7a de adopción de Cuadre).
/// Una fila por día de la semana en que el empleado trabaja — la AUSENCIA
/// de fila para un día significa que ese día no se trabaja (no hay un
/// booleano "trabaja"). `horaEntrada`/`horaSalida` son `String "HH:MM"` a
/// propósito, no `DateTime`: ya se encontraron dos bugs de timezone esta
/// fase con campos de hora/fecha sin zona (ver Kardex/Lote) — un string
/// zero-padded ordena y compara bien sin ese riesgo. Usado por
/// AsistenciaService para calcular `tardanza` al marcar entrada.
model HorarioEmpleado {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleadoId  String
  empleado    Empleado  @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  diaSemana   DiaSemana
  horaEntrada String
  horaSalida  String

  @@unique([tenantId, empleadoId, diaSemana])
  @@map("horarios_empleado")
}

/// Marcaje de asistencia (Fase 7b de adopción de Cuadre) — una fila por
/// empleado por día calendario, completada progresivamente (entrada
/// primero, salida después). Deliberadamente separado de cualquier
/// evento de login/logout del sistema (`User`/JWT): el usuario pidió
/// explícitamente que el empleado tenga que "hacer un registro para
/// RRHH", no que loguearse cuente como marcaje. `fecha` es el día
/// calendario a medianoche UTC (mismo patrón que el resto del proyecto
/// para fechas sin hora — ver ARCHITECTURE.md sobre mostrar siempre con
/// `{timeZone:'UTC'}`); `horaEntrada`/`horaSalida` son `String "HH:MM"`
/// en hora de República Dominicana (America/Santo_Domingo, sin DST),
/// calculada en el backend con `zona-horaria-rd.util.ts` — nunca la
/// hora local del proceso Node, que puede correr en UTC dentro de
/// Docker. `tardanza` se calcula una sola vez al marcar la entrada,
/// comparando contra `HorarioEmpleado` del día correspondiente.
model RegistroAsistencia {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleadoId       String
  empleado         Empleado         @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  fecha            DateTime
  horaEntrada      String?
  horaSalida       String?
  tardanza         Boolean          @default(false)
  // Umbral de horas extra + tolerancia de salida anticipada (plan de
  // integración Cuadre, ítem G-4), calculados una sola vez al marcar la
  // salida (o en registrarManual si viene horaSalida) — mismo criterio
  // que `tardanza`: contra `HorarioEmpleado` del día y los valores
  // configurables `Configuracion.ASISTENCIA_UMBRAL_HORAS_EXTRA`/
  // `ASISTENCIA_TOLERANCIA_SALIDA_ANTICIPADA_MIN`. `horasExtra` queda
  // `null` si no se puede calcular (falta horaEntrada u horaSalida).
  salidaAnticipada Boolean          @default(false)
  horasExtra       Decimal?         @db.Decimal(5, 2)
  // Flujo de aprobación (plan de integración Cuadre, ítem G-3) — mismo
  // patrón que Ausencia.estado/aprobadoPorId/fechaResolucion. Puramente
  // de revisión/auditoría de RRHH: a diferencia de Ausencia, ningún
  // cálculo de nómina lee `estado` (RegistroAsistencia no alimenta
  // PeriodosNominaService, solo Ausencia lo hace) — marcar/aprobar/
  // rechazar no cambia ningún monto pagado.
  estado           EstadoAsistencia @default(PENDIENTE)
  aprobadoPorId    String?
  aprobadoPor      User?            @relation("AsistenciaAprobadaPor", fields: [aprobadoPorId], references: [id], onDelete: Cascade)
  fechaResolucion  DateTime?

  @@unique([tenantId, empleadoId, fecha])
  @@map("registros_asistencia")
}

enum EstadoAsistencia {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoAusencia {
  VACACIONES
  ENFERMEDAD
  PERMISO
  INJUSTIFICADA
  MATERNIDAD_PATERNIDAD
  OTRO
}

enum EstadoAusencia {
  SOLICITADA
  APROBADA
  RECHAZADA
}

/// Solicitud de ausencia con flujo de aprobación (Fase 7c de adopción de
/// Cuadre) — SOLICITADA -> APROBADA/RECHAZADA, mismo patrón de dos FK
/// nombradas hacia `User` que `TurnoCaja.cajeroId`/`cerradoPorId`.
/// `conGoceDeSueldo` decide si esta ausencia descuenta salario al
/// generar nómina (Fase 7d, `PeriodosNominaService.generarPeriodo`) —
/// el usuario pidió explícitamente que las ausencias SIN goce SÍ
/// rebajen el sueldo real, no que quede solo informativo. Solo una
/// `APROBADA` afecta nómina/balance de vacaciones; `SOLICITADA`/
/// `RECHAZADA` son historial sin efecto.
/// Calendario de feriados por tenant (plan de integración Cuadre, ítem
/// G-5) — catálogo puro, deliberadamente sin ningún efecto automático en
/// tardanza/horas extra/nómina todavía (eso sería un ítem propio, más
/// grande, si el negocio lo necesita). `recurrenteAnual` decide si
/// `fecha` se compara ignorando el año (feriados fijos como Año Nuevo) o
/// exacta (un feriado puntual de un año específico).
model Feriado {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre          String
  fecha           DateTime
  recurrenteAnual Boolean  @default(true)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([tenantId, nombre, fecha])
  @@map("feriados")
}

model Ausencia {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleadoId      String
  empleado        Empleado       @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipo            TipoAusencia
  fechaDesde      DateTime
  fechaHasta      DateTime
  conGoceDeSueldo Boolean
  motivo          String?
  estado          EstadoAusencia @default(SOLICITADA)
  solicitadoPorId String
  solicitadoPor   User           @relation("AusenciaSolicitadaPor", fields: [solicitadoPorId], references: [id], onDelete: Cascade)
  aprobadoPorId   String?
  aprobadoPor     User?          @relation("AusenciaAprobadaPor", fields: [aprobadoPorId], references: [id], onDelete: Cascade)
  fechaResolucion DateTime?
  createdAt       DateTime       @default(now())

  @@map("ausencias")
}

/// Reglas configurables por tenant para cada valor del enum TipoAusencia
/// (plan de integración Cuadre, ítem G-2) — alcance reducido a propósito:
/// NO se reemplaza el enum por un catálogo libre porque VACACIONES es
/// legalmente especial (Código de Trabajo, balance por antigüedad ya
/// calculado en vacaciones.util.ts) y en RD los tipos de ausencia son
/// categorías fijas, no algo que un negocio necesite inventar. Lo
/// realmente configurable es la REGLA de cada tipo: goce por defecto,
/// si requiere aprobación o se auto-aprueba, y un tope de días/año
/// (ignorado para VACACIONES, que sigue su propio cálculo legal).
/// Sembrado automático de las 6 filas al provisionar un tenant (ver
/// TipoAusenciaConfigRepository.asegurarSembrado) y por migración para
/// tenants ya existentes.
model TipoAusenciaConfig {
  id                        String       @id @default(uuid())
  tenantId                  String
  tenant                    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo                      TipoAusencia
  maximoDiasPorAnio         Int?
  conGoceDeSueldoPorDefecto Boolean      @default(true)
  requiereAprobacion        Boolean      @default(true)
  activo                    Boolean      @default(true)
  createdAt                 DateTime     @default(now())

  @@unique([tenantId, tipo])
  @@map("tipos_ausencia_config")
}

model PeriodoNomina {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo        TipoPeriodoNomina
  fechaInicio DateTime
  fechaFin    DateTime
  fechaPago   DateTime?
  estado      EstadoPeriodoNomina @default(BORRADOR)
  createdAt   DateTime            @default(now())

  recibos ReciboNomina[]

  @@map("periodos_nomina")
}

/// Un recibo por empleado por período. Los montos patronales (sfsEmpleador,
/// afpEmpleador, infotep) no afectan el neto pagado al empleado — se
/// guardan igual porque son costo laboral real y alimentan el asiento
/// contable automático (ver NominaEventosService/AsientosContablesService).
model ReciboNomina {
  id                 String        @id @default(uuid())
  periodoId          String
  periodo            PeriodoNomina @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  empleadoId         String
  // Cascade: mismo patrón/razón que LineaAsiento.cuentaContable — Tenant ->
  // Empleado y Tenant -> PeriodoNomina -> ReciboNomina son ramas hermanas
  // que compiten al borrar un tenant completo.
  empleado           Empleado      @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  salarioBruto       Decimal       @db.Decimal(14, 2)
  sfsEmpleado        Decimal       @db.Decimal(14, 2)
  afpEmpleado        Decimal       @db.Decimal(14, 2)
  isr                Decimal       @db.Decimal(14, 2)
  otrasDeducciones   Decimal       @default(0) @db.Decimal(14, 2)
  // Descuento por ausencias sin goce de sueldo (Fase 7d de RRHH) — se
  // muestra separado de otrasDeducciones (ese sigue siendo el ajuste
  // manual de siempre) para que quede visible por qué se descontó.
  descuentoAusencias Decimal       @default(0) @db.Decimal(14, 2)
  // Monto ya calculado (RD$, no horas) de horas extra registradas en
  // Asistencia dentro del rango del período — ver calculo-nomina.ts.
  montoHorasExtra    Decimal       @default(0) @db.Decimal(14, 2)
  salarioNeto        Decimal       @db.Decimal(14, 2)
  sfsEmpleador       Decimal       @db.Decimal(14, 2)
  afpEmpleador       Decimal       @db.Decimal(14, 2)
  infotep            Decimal       @db.Decimal(14, 2)
  createdAt          DateTime      @default(now())

  @@unique([periodoId, empleadoId])
  @@map("recibos_nomina")
}

// ============================================================
// POS (punto de venta) — sin modo offline en v1, ver ARCHITECTURE.md
// ============================================================

// Usado SOLO por PagoPlataforma (lo que la plataforma le cobra al
// tenant) — el lado tenant (Factura/Pago) usa el catálogo configurable
// FormaPago (ver abajo), no este enum.
enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

/// Catálogo de formas de pago configurable por tenant (Efectivo, Tarjeta,
/// Transferencia, Crédito Cliente, Cheque, Nota de Crédito, etc.) — antes un
/// enum fijo (`MetodoPago`, que sigue existiendo pero solo para
/// PagoPlataforma). `esEfectivo` marca cuál de todas cuenta como efectivo
/// físico para el arqueo de caja (ver PosRepository.calcularMovimientoEfectivo)
/// — debería haber como mucho una en `true` por tenant, pero no se fuerza a
/// nivel de base, se valida en FormasPagoService.
model FormaPago {
  id                 String         @id @default(uuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre             String
  requiereReferencia Boolean        @default(false)
  esEfectivo         Boolean        @default(false)
  // Marca la forma de pago "Bono" (Fase 4c) para identificarla en código
  // sin comparar por nombre — mismo criterio que esEfectivo.
  // FacturacionService.crear() usa esto para tratar `PagoVenta.referencia`
  // como el código de un Bono a canjear, en vez de una referencia libre.
  esBono             Boolean        @default(false)
  // Marca la forma de pago "Puntos de Lealtad" (ítem A-3) — mismo
  // criterio que esBono: FacturacionService.crear() usa esto para
  // convertir el monto de esa línea de pago a puntos (vía
  // ConfiguracionLealtad.valorPunto) y descontarlos del saldo del
  // cliente, en vez de tratarlo como un cobro real.
  esPuntosLealtad    Boolean        @default(false)
  // Clasificación estructurada (plan de integración Cuadre, ítem E-11) —
  // puramente informativa/de reporte, nullable (no reemplaza esEfectivo/
  // esBono, que siguen gatillando comportamiento real: arqueo de caja y
  // canje de Bono respectivamente). Sin valor confiable para clasificar
  // automáticamente una fila con nombre personalizado ya existente — se
  // deja null hasta que un admin la clasifique a mano.
  tipo               TipoFormaPago?
  activa             Boolean        @default(true)
  createdAt          DateTime       @default(now())

  facturas   Factura[]
  pagos      Pago[]
  pagosVenta PagoVenta[]

  @@unique([tenantId, nombre])
  @@map("formas_pago")
}

/// Clasificación estructurada de FormaPago (plan de integración Cuadre,
/// ítem E-11) — 7 categorías, calcada del catálogo de Cuadre. "CREDITO"
/// es la clasificación de "Crédito Cliente" (que YA existe como fila
/// sembrada en FORMAS_PAGO_BASE, solo con el nombre, sin comportamiento
/// de cuenta corriente detrás) — implementar el descuento real contra
/// `Cliente.limiteCredito` queda deliberadamente fuera de este ítem: es
/// una funcionalidad de cuentas por cobrar más grande, candidata a su
/// propia sesión de diseño, no un campo de catálogo chico.
enum TipoFormaPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CREDITO
  BONO_VOUCHER
  NOTA_CREDITO
  CHEQUE
  PUNTOS_LEALTAD
}

/// Catálogo de niveles de precio por tenant (General, Mayorista,
/// Distribuidor, Especial, etc.). `Precio.listaPrecio` sigue siendo un
/// String libre sin FK a esta tabla — este catálogo solo alimenta
/// selectores de UI (Cliente.listaPrecioId, el formulario de Precio, el
/// override manual al facturar) y debe usar exactamente los mismos
/// nombres que ya circulan como `Precio.listaPrecio` (empezando por
/// "GENERAL", el default histórico). Sin endpoint de borrado — igual
/// criterio que FormaPago: se desactiva, no se elimina.
model ListaPrecio {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  clientes Cliente[]

  @@unique([tenantId, nombre])
  @@map("listas_precio")
}

/// Catálogo de leyes fiscales (plan de integración Cuadre, ítem B-3) —
/// reglas que reducen el ITBIS efectivo de un Producto para casos
/// especiales (ej. Norma 07-2007 construcción: `porcentajeItbisAPagar:
/// 10` significa que solo se paga 10% del ITBIS normal del producto —
/// 18%→1.8% efectivo). Se ata al Producto, no al Cliente ni a la
/// Factura — decisión del usuario: la reducción depende de QUÉ se
/// vende. Sin endpoint de borrado — mismo criterio que FormaPago/
/// ListaPrecio: se desactiva, no se elimina.
model LeyFiscal {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codigo                String
  nombre                String
  porcentajeItbisAPagar Decimal  @db.Decimal(5, 2)
  descripcion           String?
  activa                Boolean  @default(true)
  createdAt             DateTime @default(now())

  productos Producto[]

  @@unique([tenantId, codigo])
  @@map("leyes_fiscales")
}

/// Tasas de cambio (ítem C-2, multi-moneda) — catálogo manual, sin feed
/// automático (mismo criterio que Cuadre: entrada manual, sin fecha de
/// vigencia futura, la tasa vigente es la última guardada). `tasa` =
/// cuántos DOP vale 1 unidad de `moneda` (ej. USD con tasa 58.50 — "el
/// dólar está a 58.50"), dirección elegida por ser la más natural para
/// un negocio dominicano, no necesariamente la de Cuadre ("1 DOP = X
/// moneda"). Solo afecta la PRESENTACIÓN de una venta (ver
/// `Factura.moneda`/`tasaCambio`/`*Moneda` y ARCHITECTURE.md) — nunca
/// toca `Producto.precios`/costos, que siguen siempre en DOP.
model TasaCambio {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moneda        String
  tasa          Decimal  @db.Decimal(14, 6)
  actualizadaEn DateTime @updatedAt

  @@unique([tenantId, moneda])
  @@map("tasas_cambio")
}

/// Ledger de "con qué se pagó" una venta de POS — permite pagos divididos
/// (parte efectivo + parte tarjeta en la misma factura). Distinto de `Pago`
/// (abonos POSTERIORES de AR/AP, ej. una factura a crédito) — acá el pago
/// es simultáneo a la creación de la factura. `Factura.formaPagoId`/
/// `referenciaPago` se conservan como "forma de pago principal" (la de
/// mayor monto) para lectura rápida/reportes, pero la fuente de verdad
/// para el arqueo de caja es esta tabla — ver PosRepository.
/// Tabla "hija" sin tenantId propio (mismo patrón que LineaFactura): su
/// aislamiento depende de llegar siempre vía Factura, ya tenant-scoped.
model PagoVenta {
  id          String    @id @default(uuid())
  facturaId   String
  factura     Factura   @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  formaPagoId String
  formaPago   FormaPago @relation(fields: [formaPagoId], references: [id])
  monto       Decimal   @db.Decimal(14, 2)
  referencia  String?
  createdAt   DateTime  @default(now())

  @@map("pagos_venta")
}

enum FormatoImpresion {
  CARTA
  A4
  TERMICA_80MM
  TERMICA_58MM
}

/// PENDIENTE_REVISION (plan de integración Cuadre, ítem E-6): un turno
/// cuya diferencia de arqueo excedió la tolerancia configurada cae acá al
/// cerrarse (en vez de directo a CERRADO) — un supervisor lo revisa
/// después vía `PATCH /pos/turnos/:id/revisar` y ahí sí pasa a CERRADO.
enum EstadoTurnoCaja {
  ABIERTO
  PENDIENTE_REVISION
  CERRADO
}

/// Color decorativo de categoría, para escaneo visual rápido en la grilla
/// del POS (plan de integración Cuadre, E-9) — sin significado de
/// negocio, solo UX.
enum ColorCategoria {
  GRIS
  ROJO
  NARANJA
  AMBAR
  VERDE
  TURQUESA
  CIAN
  AZUL
  INDIGO
  MORADO
  ROSA
  FUCSIA
}

enum TipoMovimientoCaja {
  ENTRADA
  SALIDA
}

/// Motivo estructurado de un movimiento manual de caja (plan de
/// integración de brechas Cuadre, ítem F-5) — opcional, coexiste con
/// `concepto` (texto libre) sin reemplazarlo.
enum MotivoMovimientoCaja {
  FONDO_CAMBIO
  DEPOSITO
  CORRECCION
  OTRO
}

/// Un turno de caja por bodega/cajero. Solo puede haber un ABIERTO a la
/// vez por bodega (lo valida PosService, no una constraint de DB, porque
/// "a la vez" depende del estado, no de una combinación de columnas fija).
model TurnoCaja {
  id                      String          @id @default(uuid())
  tenantId                String
  tenant                  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bodegaId                String
  // Cascade: mismo patrón que LineaAsiento.cuentaContable — Tenant -> Bodega
  // y Tenant -> TurnoCaja son ramas hermanas que compiten al borrar el tenant.
  bodega                  Bodega          @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  // Ítem E-7 — opcional: sin Caja elegida, el turno funciona exactamente
  // igual que antes de este ítem, sin ninguna restricción de catálogo.
  cajaId                  String?
  caja                    Caja?           @relation(fields: [cajaId], references: [id], onDelete: SetNull)
  cajeroId                String
  // Cascade por la misma razón (Tenant -> User es otra rama hermana).
  cajero                  User            @relation(fields: [cajeroId], references: [id], onDelete: Cascade)
  montoInicial            Decimal         @db.Decimal(14, 2)
  montoFinalContado       Decimal?        @db.Decimal(14, 2)
  montoEsperado           Decimal?        @db.Decimal(14, 2)
  diferencia              Decimal?        @db.Decimal(14, 2)
  estado                  EstadoTurnoCaja @default(ABIERTO)
  abiertoEn               DateTime        @default(now())
  cerradoEn               DateTime?
  cerradoPorId            String?
  // Cascade por la misma razón que cajeroId (rama hermana Tenant -> User).
  // Nullable + relación nombrada porque ya existe otra relación User->TurnoCaja
  // (cajeroId, sin nombre explícito) — Prisma exige distinguirlas.
  cerradoPor              User?           @relation("TurnoCajaCerradoPor", fields: [cerradoPorId], references: [id], onDelete: Cascade)
  justificacionDiferencia String?
  // PENDIENTE_REVISION -> CERRADO (ítem E-6) — quién y cuándo lo aprobó.
  revisadoEn              DateTime?
  revisadoPorId           String?
  revisadoPor             User?           @relation("TurnoCajaRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: Cascade)

  movimientos     MovimientoCaja[]
  facturas        Factura[]
  ventasAparcadas VentaAparcada[]
  carritoBorrador CarritoBorrador?

  @@map("turnos_caja")
}

enum TipoCodigoAutorizacion {
  ANULACION_FACTURA
  DEVOLUCION_POS
}

/// Segunda capa de autorización (plan de integración Cuadre, ítem D-1) —
/// opcional por tenant vía Configuracion (`AUTORIZACION_2FA_ANULAR`/
/// `AUTORIZACION_2FA_DEVOLUCION`), complementa el PIN autoservicio de
/// Fase 9: un código de un solo uso enviado por EMAIL a un tercero real
/// (encargado de la sucursal, o Admin Total si no hay uno asignado — ver
/// AutorizacionesService.resolverDestinatarios), no algo que el mismo
/// cajero pueda autoaprobar. `referenciaId` es la Factura a anular
/// (ANULACION_FACTURA) o la Factura original a devolver (DEVOLUCION_POS)
/// — sin FK propia porque el tipo decide de qué tabla es el id, mismo
/// criterio que `referenciaTipo`/`referenciaId` en MovimientoInventario.
model CodigoAutorizacion {
  id               String                 @id @default(uuid())
  tenantId         String
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo             TipoCodigoAutorizacion
  referenciaId     String
  codigoHash       String
  expiraEn         DateTime
  intentosFallidos Int                    @default(0)
  usadoEn          DateTime?
  solicitadoPorId  String
  solicitadoPor    User                   @relation(fields: [solicitadoPorId], references: [id], onDelete: Cascade)
  createdAt        DateTime               @default(now())

  @@index([tenantId, tipo, referenciaId])
  @@map("codigos_autorizacion")
}

/// Entradas/salidas de efectivo dentro de un turno abierto que NO son una
/// venta (retiro para gasto menor, ingreso de vuelto adicional, etc.) —
/// las ventas ya se contabilizan directamente vía Factura.turnoCajaId.
model MovimientoCaja {
  id         String                @id @default(uuid())
  turnoId    String
  turno      TurnoCaja             @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  tipo       TipoMovimientoCaja
  monto      Decimal               @db.Decimal(14, 2)
  concepto   String
  motivoTipo MotivoMovimientoCaja?
  createdAt  DateTime              @default(now())

  @@map("movimientos_caja")
}

/// Carrito "aparcado" (Guardar/Guardadas, F12/⇧F12) — el cajero atiende
/// otro cliente sin perder lo ya armado. Snapshot de precio/ITBIS/descuento
/// por línea (no se re-cotiza al recuperar) para que el monto no cambie
/// mientras estuvo aparcada. Vive mientras el turno sigue abierto
/// (onDelete: Cascade) — no está pensada para sobrevivir al cierre.
model VentaAparcada {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turnoCajaId        String
  turnoCaja          TurnoCaja @relation(fields: [turnoCajaId], references: [id], onDelete: Cascade)
  clienteId          String?
  cliente            Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  vendedorEmpleadoId String?
  vendedorEmpleado   Empleado? @relation(fields: [vendedorEmpleadoId], references: [id], onDelete: SetNull)
  nota               String?
  createdAt          DateTime  @default(now())

  lineas VentaAparcadaLinea[]

  @@map("ventas_aparcadas")
}

// Persistencia incremental del carrito del POS en curso — se guarda solo
// (upsert, un registro por turno abierto) desde que hay al menos una línea
// o se asigna cliente/vendedor, para no perder la venta si el navegador se
// refresca o el equipo se apaga antes de "Cobrar"/"Guardar venta" (F12).
// Distinto de VentaAparcada: eso es un aparcado EXPLÍCITO del cajero (para
// atender a otro cliente, puede haber varios a la vez); esto es un borrador
// SILENCIOSO del carrito activo (uno solo, se sobrescribe) — mezclarlos en
// la misma tabla ensuciaría la lista de "Guardadas" con carritos que el
// cajero nunca decidió aparcar. `lineas` en Json, no tabla hija propia,
// mismo criterio que WebhookDelivery.payload: es un borrador transitorio
// sin necesidad de integridad referencial, se borra al confirmar la venta,
// al aparcarla (ya queda a salvo en VentaAparcada) o al vaciar el carrito.
model CarritoBorrador {
  id                      String    @id @default(uuid())
  tenantId                String
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turnoCajaId             String    @unique
  turnoCaja               TurnoCaja @relation(fields: [turnoCajaId], references: [id], onDelete: Cascade)
  // SetNull (no Cascade): borrar el cliente/vendedor no debe borrar el
  // borrador — sigue siendo útil restaurar las líneas, solo se pierde la
  // referencia (mismo criterio que VentaAparcada).
  clienteId               String?
  cliente                 Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  vendedorEmpleadoId      String?
  vendedorEmpleado        Empleado? @relation(fields: [vendedorEmpleadoId], references: [id], onDelete: SetNull)
  // Nombre de la ListaPrecio (ej. "MAYORISTA"), no su id — mismo campo que
  // RegistrarVentaPosDto.listaPrecio/CotizarVentaPosDto.listaPrecio, sin FK
  // propia por la misma razón que esos DTOs: es un override puntual de la
  // venta, no una referencia estructural.
  listaPrecio             String?
  tipoFactura             String?
  comprobanteFiscal       String?
  lineas                  Json
  actualizadoEn           DateTime  @updatedAt

  @@map("carritos_borrador")
}

// Tabla "hija" sin tenantId propio (mismo patrón que LineaFactura) — su
// aislamiento depende de llegar siempre vía VentaAparcada, ya tenant-scoped.
model VentaAparcadaLinea {
  id              String           @id @default(uuid())
  ventaAparcadaId String
  ventaAparcada   VentaAparcada    @relation(fields: [ventaAparcadaId], references: [id], onDelete: Cascade)
  productoId      String
  producto        Producto         @relation(fields: [productoId], references: [id])
  // Ver el comentario equivalente en LineaFactura.varianteId.
  varianteId      String
  variante        VarianteProducto @relation(fields: [varianteId], references: [id])
  cantidad        Decimal          @db.Decimal(14, 4)
  precioUnitario  Decimal          @db.Decimal(14, 4)
  porcentajeItbis Decimal          @db.Decimal(5, 2)
  descuento       Decimal          @default(0) @db.Decimal(14, 2)

  @@map("lineas_venta_aparcada")
}

// ============================================================
// PRODUCTOS, PRECIOS, INVENTARIO
// ============================================================

enum TipoProducto {
  PRODUCTO
  SERVICIO
  COMBO
}

// Mapea 1:1 a `object-fit` de CSS — cómo encajar `Producto.imagen` dentro
// del recuadro fijo de la tarjeta (catálogo del POS, miniatura del
// formulario). COVER (default, recorta para llenar el recuadro) es el
// comportamiento que ya existía hardcodeado antes de este campo.
enum AjusteImagenProducto {
  COVER
  CONTAIN
  FILL
  NONE
  SCALE_DOWN
}

/// Catálogo de categorías con jerarquía real (mismo patrón de auto-relación
/// que `CuentaContable.cuentaPadreId` — no un prefijo de código, que en la
/// práctica nadie parsea en tiempo de ejecución). El frontend arma el árbol
/// a partir del listado plano con `categoriaPadreId`.
model Categoria {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre           String
  categoriaPadreId String?
  categoriaPadre   Categoria?      @relation("JerarquiaCategoria", fields: [categoriaPadreId], references: [id])
  subcategorias    Categoria[]     @relation("JerarquiaCategoria")
  activa           Boolean         @default(true)
  color            ColorCategoria?
  createdAt        DateTime        @default(now())

  productos      Producto[]
  ofertas        Oferta[]
  cajaCategorias CajaCategoria[]

  @@unique([tenantId, nombre])
  @@map("categorias")
}

model Producto {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codigo              String
  nombre              String
  categoriaId         String?
  categoria           Categoria?           @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  unidadMedida        String               @default("UND")
  porcentajeItbis     Decimal              @default(18) @db.Decimal(5, 2)
  // Ley fiscal aplicable (plan de integración Cuadre, ítem B-3) — reduce
  // el ITBIS efectivo de este producto (ej. Norma 07-2007 construcción:
  // solo se paga 10% del ITBIS normal → 18%→1.8% efectivo). Se ata al
  // Producto (decisión del usuario: la reducción depende de QUÉ se
  // vende, no de quién compra) — ver FacturacionService.
  // calcularLineasYTotales.
  leyFiscalId         String?
  leyFiscal           LeyFiscal?           @relation(fields: [leyFiscalId], references: [id], onDelete: SetNull)
  // PRODUCTO mueve inventario normal; SERVICIO nunca toca Stock; COMBO
  // expande a sus `componentes` al facturarse (ver FacturacionService.
  // expandirParaInventario) — nunca tiene fila propia en Stock.
  tipo                TipoProducto         @default(PRODUCTO)
  activo              Boolean              @default(true)
  origenMssql         Boolean              @default(false)
  // Opt-in (Fase 5b de adopción de Cuadre, mismo patrón que esEfectivo/
  // esBono) — si está apagado, este producto sigue funcionando exactamente
  // igual que hoy, sin exigir lote nunca. Ver ARCHITECTURE.md, "Vencimientos".
  controlaVencimiento Boolean              @default(false)
  // Campos avanzados de producto (plan de integración Cuadre, ítem E-8).
  // `precioVariable`: habilita un precio editable por línea en el carrito
  // del POS (ej. artículos pesados o de precio negociado) — sin esto, el
  // precio de línea siempre sale del catálogo. `esIngrediente`: puramente
  // informativo (no hay motor de recetas/BOM) — mismo criterio que
  // `Categoria.color`. `permiteDevolucion`: si es false,
  // `FacturacionService.crear()` rechaza una NOTA_CREDITO que incluya
  // este producto.
  precioVariable      Boolean              @default(false)
  esIngrediente       Boolean              @default(false)
  permiteDevolucion   Boolean              @default(true)
  // Comisión de venta (plan de integración Cuadre, ítem A-1) — mutuamente
  // excluyentes (validado en ProductosService, no en el schema, mismo
  // criterio que Oferta.valor/comprarCantidad): `porcentajeComision` (%
  // sobre el monto neto SIN ITBIS de cada línea vendida) o
  // `montoComisionFijo` (RD$ fijos por unidad vendida). Sin ninguno de
  // los dos, el producto simplemente no genera comisión — ver
  // ComisionesService.generarDesdeFactura.
  porcentajeComision  Decimal?             @db.Decimal(5, 2)
  montoComisionFijo   Decimal?             @db.Decimal(14, 2)
  // Data URI completa (data:image/jpeg;base64,...), comprimida en el
  // cliente antes de subir. `listar()` (el listado general de
  // Productos.tsx) NO la selecciona a propósito — solo `catalogo()`
  // (pensado para el catálogo del POS) y `buscarPorId()` la incluyen,
  // para no inflar la página normal con blobs — ver ProductosRepository.
  imagen              String?              @db.Text
  imagenAjuste        AjusteImagenProducto @default(COVER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Precio/Stock ya no cuelgan directo de Producto (Fase 3c — ver
  // VarianteProducto): todo producto tiene siempre al menos una variante
  // "por defecto", incluso sin atributos reales.
  variantes              VarianteProducto[]
  movimientos            MovimientoInventario[]
  lineasFactura          LineaFactura[]
  lineasOc               LineaOc[]
  lineasRecepcion        LineaRecepcion[]
  lineasCotizacion       LineaCotizacion[]
  lineasRemision         LineaRemision[]
  lineasDevolucionCompra LineaDevolucionCompra[]
  lineasVentaAparcada    VentaAparcadaLinea[]
  lineasAjusteInventario LineaAjusteInventario[]
  lineasTransferenciaInventario LineaTransferenciaInventario[]
  // Componentes de ESTE producto cuando `tipo: COMBO`.
  componentes            ComponenteCombo[]       @relation("ComboComponentes")
  // Combos de los que este producto forma parte (como componente).
  partesDeCombos         ComponenteCombo[]       @relation("ComponenteDeCombos")
  ofertas                Oferta[]
  comisionesVenta        ComisionVenta[]
  cajaProductos          CajaProducto[]
  cajaProductoFavoritos  CajaProductoFavorito[]

  @@unique([tenantId, codigo])
  @@map("productos")
}

// Tabla "hija" sin tenantId propio (mismo patrón que LineaFactura/Stock/
// Precio, ver DATABASE.md) — su aislamiento depende de llegar siempre vía
// un Producto (combo) ya resuelto contra el tenant. `componenteId` está
// restringido en ProductosService a productos PRODUCTO/SERVICIO (nunca
// COMBO) para no permitir combos anidados.
model ComponenteCombo {
  id           String   @id @default(uuid())
  comboId      String
  combo        Producto @relation("ComboComponentes", fields: [comboId], references: [id], onDelete: Cascade)
  componenteId String
  componente   Producto @relation("ComponenteDeCombos", fields: [componenteId], references: [id], onDelete: Cascade)
  cantidad     Decimal  @db.Decimal(14, 4)

  @@unique([comboId, componenteId])
  @@map("componentes_combo")
}

/// SKU real de un producto (Fase 3c de adopción de Cuadre): un producto
/// tiene siempre al menos una variante — la "por defecto", sin valores de
/// atributo asociados — para que un producto que nunca usó atributos
/// reales (Talla/Color) siga teniendo exactamente una fila de stock/precio,
/// igual que antes de esta fase. `tenantId` propio (a diferencia de
/// `LineaFactura`/`PagoVenta`, hijas sin tenantId): se consulta directo muy
/// seguido (Stock, catálogo del POS, búsqueda por código de barras) y
/// necesita `@@unique([tenantId, codigoBarras])` sin depender de un join a
/// `Producto`.
model VarianteProducto {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoId   String
  producto     Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sku          String?
  codigoBarras String?
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())

  valoresAtributo        ValorAtributoVariante[]
  precios                Precio[]
  stock                  Stock[]
  movimientos            MovimientoInventario[]
  lotes                  Lote[]
  lineasFactura          LineaFactura[]
  lineasCotizacion       LineaCotizacion[]
  lineasRemision         LineaRemision[]
  lineasOc               LineaOc[]
  lineasRecepcion        LineaRecepcion[]
  lineasDevolucionCompra LineaDevolucionCompra[]
  lineasVentaAparcada    VentaAparcadaLinea[]
  lineasAjusteInventario LineaAjusteInventario[]
  lineasTransferenciaInventario LineaTransferenciaInventario[]

  @@unique([tenantId, codigoBarras])
  @@map("variantes_producto")
}

/// Catálogo de atributos definibles por tenant ("Talla", "Color") — Fase 3c.
model Atributo {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  createdAt DateTime @default(now())

  valores ValorAtributo[]

  @@unique([tenantId, nombre])
  @@map("atributos")
}

/// Valores concretos de un atributo ("M", "Azul"). Hija sin tenantId propio
/// (mismo patrón que ComponenteCombo) — su aislamiento depende de llegar
/// siempre vía Atributo, ya tenant-scoped.
model ValorAtributo {
  id         String   @id @default(uuid())
  atributoId String
  atributo   Atributo @relation(fields: [atributoId], references: [id], onDelete: Cascade)
  valor      String

  variantes ValorAtributoVariante[]

  @@unique([atributoId, valor])
  @@map("valores_atributo")
}

/// Puente variante<->valor de atributo. Una variante tiene a lo sumo un
/// valor por atributo — se valida en el service al generar las
/// combinaciones (Fase 3c, incremento 2), no a nivel de constraint de base
/// (el `@@id` de acá solo evita asignar el mismo valor dos veces a la
/// misma variante).
model ValorAtributoVariante {
  varianteId      String
  variante        VarianteProducto @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  valorAtributoId String
  valorAtributo   ValorAtributo    @relation(fields: [valorAtributoId], references: [id], onDelete: Cascade)

  @@id([varianteId, valorAtributoId])
  @@map("valores_atributo_variante")
}

model Precio {
  id           String           @id @default(uuid())
  varianteId   String
  variante     VarianteProducto @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  listaPrecio  String           @default("GENERAL")
  costo        Decimal          @db.Decimal(14, 4)
  margenPct    Decimal          @db.Decimal(6, 2)
  precioVenta  Decimal          @db.Decimal(14, 4)
  vigenteDesde DateTime         @default(now())
  vigenteHasta DateTime?

  @@index([varianteId, listaPrecio, vigenteDesde])
  @@map("precios")
}

/// Local físico (Fase 8 de adopción de Cuadre) que agrupa 1+ Bodegas —
/// el caso común (1 sucursal = 1 bodega) sigue siendo igual de simple,
/// pero un local grande puede tener varias bodegas internas (piso de
/// venta + depósito). Campos "comerciales" (nombreComercial/telefono/
/// ciudad) separados de `direccion` a propósito, para no forzar a
/// estructurar lo que hoy es solo un `String?` libre en `Bodega`.
model Sucursal {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre          String
  nombreComercial String?
  telefono        String?
  direccion       String?
  ciudad          String?
  activa          Boolean  @default(true)
  createdAt       DateTime @default(now())

  bodegas      Bodega[]
  usuarios     UsuarioSucursal[]
  ncfAsignados NcfAsignado[]

  @@unique([tenantId, nombre])
  @@map("sucursales")
}

/// Sucursales en las que trabaja un usuario (Fase 8b) — copia exacta del
/// patrón `UserRole`. Sin ninguna asignación = ve/puede elegir TODAS las
/// del tenant (default permisivo, ver `SucursalesController.mias` en
/// 8c) — esta fase NO agrega ningún guard que restrinja acceso, eso es
/// Fase 9 (PIN + permisos por sucursal).
model UsuarioSucursal {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([userId, sucursalId])
  @@map("usuario_sucursales")
}

model Bodega {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId       String
  // Cascade: Tenant -> Sucursal -> Bodega es una cadena normal (no una
  // carrera de ramas hermanas) — borrar la sucursal se lleva sus bodegas.
  sucursal         Sucursal          @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  nombre           String
  direccion        String?
  activa           Boolean           @default(true)
  // null = hereda el default de Configuracion[FORMATO_IMPRESION_DEFAULT]
  // del tenant (ver resolver-formato-impresion.ts).
  formatoImpresion FormatoImpresion?

  stock        Stock[]
  movimientos  MovimientoInventario[]
  lotes        Lote[]
  facturas     Factura[]
  remisiones   Remision[]
  turnosCaja   TurnoCaja[]
  devoluciones DevolucionCompra[]
  cajas        Caja[]
  ajustesInventario AjusteInventario[]
  transferenciasOrigen  TransferenciaInventario[] @relation("TransferenciaOrigen")
  transferenciasDestino TransferenciaInventario[] @relation("TransferenciaDestino")

  @@unique([tenantId, nombre])
  @@map("bodegas")
}

/// "Caja" como entidad propia (plan de integración Cuadre, ítem E-7) —
/// una terminal física de POS, distinta de `Bodega` (el local) y de
/// `TurnoCaja` (una jornada de un cajero). Restringe qué puede vender
/// ESA terminal — decisión confirmada con el usuario: lista blanca
/// combinada (`CajaCategoria` OR `CajaProducto`); sin ninguna fila en
/// ninguna de las dos, la Caja vende el catálogo completo (default
/// permisivo, mismo criterio que `UsuarioSucursal` sin asignaciones).
/// `CajaProductoFavorito` es independiente de la restricción — solo
/// alimenta accesos rápidos en la grilla del POS, no bloquea nada.
model Caja {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bodegaId  String
  bodega    Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  codigo    String
  nombre    String
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  categorias CajaCategoria[]
  productos  CajaProducto[]
  favoritos  CajaProductoFavorito[]
  turnos     TurnoCaja[]

  @@unique([tenantId, codigo])
  @@map("cajas")
}

// Tablas "hija" sin tenantId propio (mismo patrón que ComponenteCombo,
// ver DATABASE.md) — su aislamiento depende de llegar siempre vía una
// Caja ya resuelta contra el tenant.
model CajaCategoria {
  id          String    @id @default(uuid())
  cajaId      String
  caja        Caja      @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([cajaId, categoriaId])
  @@map("caja_categorias")
}

model CajaProducto {
  id         String   @id @default(uuid())
  cajaId     String
  caja       Caja     @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([cajaId, productoId])
  @@map("caja_productos")
}

model CajaProductoFavorito {
  id         String   @id @default(uuid())
  cajaId     String
  caja       Caja     @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([cajaId, productoId])
  @@map("caja_producto_favoritos")
}

model Stock {
  id                String           @id @default(uuid())
  varianteId        String
  variante          VarianteProducto @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  bodegaId          String
  bodega            Bodega           @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  cantidadActual    Decimal          @default(0) @db.Decimal(14, 4)
  cantidadReservada Decimal          @default(0) @db.Decimal(14, 4)
  stockMinimo       Decimal          @default(10) @db.Decimal(14, 4)
  updatedAt         DateTime         @updatedAt

  @@unique([varianteId, bodegaId])
  @@map("stock")
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  TRANSFERENCIA
  AJUSTE
}

/// Motivo estructurado de un ajuste manual de stock (plan de integración
/// de brechas Cuadre, ítem E-2) — solo lo setea `InventarioService.
/// ajustarStock`; nullable porque ENTRADA/SALIDA/TRANSFERENCIA no lo usan.
enum MotivoAjusteInventario {
  MERMA
  ROBO_PERDIDA
  DANO
  VENCIMIENTO
  CORRECCION_CONTEO
  OTRO
}

// `TRANSFERENCIA` se usa para AMBOS lados de una transferencia (origen y
// destino, mismo valor de `tipo`) y `AJUSTE` puede ser positivo o negativo
// — `cantidad` siempre se guarda en valor absoluto, así que sin esto no hay
// forma confiable de reconstruir el signo real de esos dos tipos (Fase 5a,
// Kardex — ver ARCHITECTURE.md). Se calcula automáticamente en los dos
// únicos escritores de bajo nivel (`ajustarCantidadEnTx`/
// `descontarStockCondicionalEnTx`), nunca a mano por el caller.
enum DireccionMovimiento {
  ENTRADA
  SALIDA
}

model MovimientoInventario {
  id             String                   @id @default(uuid())
  tenantId       String
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Se conserva como columna denormalizada de solo lectura (para no romper
  // reportes que ya filtran por él) — la FK real para nuevo código es
  // `varianteId`, ver Fase 3c.
  productoId     String
  producto       Producto                 @relation(fields: [productoId], references: [id])
  varianteId     String
  variante       VarianteProducto         @relation(fields: [varianteId], references: [id])
  bodegaId       String
  bodega         Bodega                   @relation(fields: [bodegaId], references: [id])
  tipo           TipoMovimientoInventario
  direccion      DireccionMovimiento
  cantidad       Decimal                  @db.Decimal(14, 4)
  motivo         String?
  motivoAjuste   MotivoAjusteInventario?
  // Ya existían, sin usar en ningún lado del código — Fase 5b los reusa
  // para vincular un movimiento de lote a su origen ('FACTURA'+facturaId
  // en ventas, 'RECEPCION_COMPRA'+recepcionId en compras), lo que le
  // permite a una Nota de Crédito reconstruir sola de qué lote(s) salió
  // la venta original, sin pedirle nada al usuario (ver ARCHITECTURE.md).
  referenciaTipo String?
  referenciaId   String?
  // Solo se setea para movimientos de productos con `controlaVencimiento`
  // (Fase 5b) — nullable, un producto sin ese flag nunca toca este campo.
  loteId         String?
  lote           Lote?                    @relation(fields: [loteId], references: [id])
  userId         String
  user           User                     @relation(fields: [userId], references: [id])
  createdAt      DateTime                 @default(now())

  @@index([tenantId, productoId, bodegaId])
  @@index([varianteId])
  @@index([loteId])
  @@map("movimiento_inventario")
}

// Control de vencimientos por lote (Fase 5b de adopción de Cuadre) — solo
// para productos con `controlaVencimiento: true`. Tenant-scoped con
// `tenantId` propio (a diferencia de `Stock`, "hija" de Bodega/Variante):
// se consulta directo muy seguido desde el consumo FEFO y el cron de
// vencimientos, y así puede tener su propio índice sin depender de un
// join. El mismo lote físico transferido a otra bodega es una fila nueva
// ahí — misma granularidad que `Stock`, que también es por variante+bodega.
model Lote {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  varianteId       String
  variante         VarianteProducto @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  bodegaId         String
  bodega           Bodega           @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  numeroLote       String
  fechaVencimiento DateTime
  cantidadActual   Decimal          @default(0) @db.Decimal(14, 4)
  createdAt        DateTime         @default(now())

  movimientos MovimientoInventario[]

  @@unique([tenantId, varianteId, bodegaId, numeroLote])
  @@index([tenantId, fechaVencimiento])
  @@map("lotes")
}

// ============================================================
// COMPRAS
// ============================================================

model Proveedor {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre   String
  rnc      String?
  email    String?
  telefono String?
  activo   Boolean @default(true)
  // Crédito general con este proveedor (ítem Cuentas por Pagar) — a
  // diferencia de Factura.plazoPagoDias (snapshot por documento),
  // OrdenCompra no tiene plazo propio: todas sus órdenes heredan este
  // valor en vivo al calcular vencimiento/antigüedad (decisión explícita
  // del usuario, ver CuentasPorPagarService).
  plazoPagoDias Int @default(30)

  ordenesCompra OrdenCompra[]

  @@map("proveedores")
}

enum EstadoOrdenCompra {
  BORRADOR
  ENVIADA
  RECIBIDA_PARCIAL
  RECIBIDA_TOTAL
  CANCELADA
}

model OrdenCompra {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proveedorId String
  proveedor   Proveedor         @relation(fields: [proveedorId], references: [id])
  numero      String
  estado      EstadoOrdenCompra @default(BORRADOR)
  fecha       DateTime          @default(now())
  total       Decimal           @db.Decimal(14, 2)
  // Igual convención que Factura.pagada/fechaPago — ver PagosService: se
  // recalcula cuando la suma de Pago contra esta orden alcanza el total.
  pagada      Boolean           @default(false)
  fechaPago   DateTime?
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now())

  lineas       LineaOc[]
  recepciones  RecepcionCompra[]
  pagos        Pago[]
  devoluciones DevolucionCompra[]

  @@unique([tenantId, numero])
  @@map("orden_compra")
}

model LineaOc {
  id               String           @id @default(uuid())
  ordenCompraId    String
  ordenCompra      OrdenCompra      @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  productoId       String
  // Cascade: mismo patrón/razón que LineaCotizacion.producto — Tenant -> Producto
  // y Tenant -> OrdenCompra -> LineaOc son ramas hermanas que compiten al borrar
  // el tenant completo (carrera real de Postgres, no solo teórica — encontrada
  // corriendo los e2e de Compras).
  producto         Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  // Ver el comentario equivalente en LineaFactura.varianteId.
  varianteId       String
  variante         VarianteProducto @relation(fields: [varianteId], references: [id])
  cantidad         Decimal          @db.Decimal(14, 4)
  costoUnitario    Decimal          @db.Decimal(14, 4)
  cantidadRecibida Decimal          @default(0) @db.Decimal(14, 4)

  @@map("linea_oc")
}

// Ítem E-1 — activa el patrón Borrador→Confirmado para Ajustes de
// inventario: hasta ahora un ajuste era una escritura instantánea sobre
// MovimientoInventario (ver InventarioService.ajustarStock), sin cabecera
// ni forma de revisarlo antes de aplicarlo. AjusteInventario.confirmar()
// (backend/src/inventario/ajustes-inventario/) reusa
// InventarioRepository.ajustarCantidadEnTx tal cual, una vez por línea —
// el único movimiento nuevo de stock real sigue siendo ese método.
enum EstadoAjusteInventario {
  BORRADOR
  CONFIRMADO
  CANCELADO
}

model AjusteInventario {
  id        String                 @id @default(uuid())
  tenantId  String
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero    String
  bodegaId  String
  bodega    Bodega                 @relation(fields: [bodegaId], references: [id])
  estado    EstadoAjusteInventario @default(BORRADOR)
  fecha     DateTime               @default(now())
  userId    String
  user      User                   @relation(fields: [userId], references: [id])
  createdAt DateTime               @default(now())

  lineas LineaAjusteInventario[]

  @@unique([tenantId, numero])
  @@map("ajuste_inventario")
}

model LineaAjusteInventario {
  id       String           @id @default(uuid())
  ajusteId String
  ajuste   AjusteInventario @relation(fields: [ajusteId], references: [id], onDelete: Cascade)
  productoId String
  producto Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteId String
  variante VarianteProducto @relation(fields: [varianteId], references: [id])
  // Positivo = entrada, negativo = salida — mismo criterio que
  // InventarioService.ajustarStock hoy.
  cantidad     Decimal                 @db.Decimal(14, 4)
  motivoAjuste MotivoAjusteInventario?
  motivo       String?
  // Solo si el producto controla vencimiento — mismo par de campos que
  // AjustarStockDto: numeroLote/fechaVencimiento en una entrada, loteId en
  // una salida (siempre explícito, nunca FEFO en un ajuste manual).
  numeroLote       String?
  fechaVencimiento DateTime?
  loteId           String?

  @@map("linea_ajuste_inventario")
}

// Ítem E-1 — mismo patrón que AjusteInventario, para Transferencias entre
// bodegas. confirmar() reusa InventarioService.transferirStockEnTx (=
// InventarioRepository.transferirEnTx) tal cual — ya resuelve FEFO/lotes
// internamente, sin necesitar nada extra por línea.
enum EstadoTransferenciaInventario {
  BORRADOR
  CONFIRMADO
  CANCELADO
}

model TransferenciaInventario {
  id              String                        @id @default(uuid())
  tenantId        String
  tenant          Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero          String
  bodegaOrigenId  String
  bodegaOrigen    Bodega                        @relation("TransferenciaOrigen", fields: [bodegaOrigenId], references: [id])
  bodegaDestinoId String
  bodegaDestino   Bodega                        @relation("TransferenciaDestino", fields: [bodegaDestinoId], references: [id])
  estado          EstadoTransferenciaInventario @default(BORRADOR)
  fecha           DateTime                      @default(now())
  userId          String
  user            User                          @relation(fields: [userId], references: [id])
  createdAt       DateTime                      @default(now())

  lineas LineaTransferenciaInventario[]

  @@unique([tenantId, numero])
  @@map("transferencia_inventario")
}

model LineaTransferenciaInventario {
  id              String                  @id @default(uuid())
  transferenciaId String
  transferencia   TransferenciaInventario @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  productoId      String
  producto        Producto                @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteId      String
  variante        VarianteProducto        @relation(fields: [varianteId], references: [id])
  cantidad        Decimal                 @db.Decimal(14, 4)

  @@map("linea_transferencia_inventario")
}

model RecepcionCompra {
  id                     String      @id @default(uuid())
  tenantId               String
  ordenCompraId          String
  // Cascade: sin esto, borrar un tenant completo cascadea a OrdenCompra pero
  // se detiene ahí — RecepcionCompra queda huérfana referenciando una orden ya
  // borrada y Postgres rechaza el borrado completo (carrera real encontrada
  // corriendo los e2e de Compras, misma clase de bug que LineaOc.producto).
  ordenCompra            OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  fecha                  DateTime    @default(now())
  facturaProveedorNumero String?
  montoFacturaProveedor  Decimal?    @db.Decimal(14, 2)
  createdAt              DateTime    @default(now())

  lineas LineaRecepcion[]

  @@map("recepcion_compra")
}

model LineaRecepcion {
  id               String           @id @default(uuid())
  recepcionId      String
  recepcion        RecepcionCompra  @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  productoId       String
  // Cascade: mismo patrón que LineaOc.producto (ver ese comentario).
  producto         Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  // Ver el comentario equivalente en LineaFactura.varianteId.
  varianteId       String
  variante         VarianteProducto @relation(fields: [varianteId], references: [id])
  cantidadRecibida Decimal          @db.Decimal(14, 4)
  costoUnitario    Decimal          @db.Decimal(14, 4)

  @@map("linea_recepcion")
}

/// Devolución de mercancía ya recibida a un proveedor — mismo patrón que
/// RecepcionCompra (tenantId propio en vez de relación, porque solo se
/// alcanza vía OrdenCompra; ver el comentario en RecepcionCompra). Reduce
/// `LineaOc.cantidadRecibida` y saca el stock correspondiente.
model DevolucionCompra {
  id            String      @id @default(uuid())
  tenantId      String
  ordenCompraId String
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  bodegaId      String
  // Cascade: mismo patrón de ramas hermanas que TurnoCaja.bodegaId (ver ese
  // comentario) — Tenant -> Bodega y Tenant -> OrdenCompra -> DevolucionCompra
  // compiten al borrar el tenant completo; sin Cascade acá, Postgres puede
  // intentar borrar la Bodega mientras esta fila todavía la referencia.
  bodega        Bodega      @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  motivo        String?
  fecha         DateTime    @default(now())
  createdAt     DateTime    @default(now())

  lineas LineaDevolucionCompra[]

  @@map("devolucion_compra")
}

model LineaDevolucionCompra {
  id            String           @id @default(uuid())
  devolucionId  String
  devolucion    DevolucionCompra @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  productoId    String
  // Cascade: mismo patrón que LineaOc.producto/LineaRecepcion.producto (ver esos comentarios).
  producto      Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  // Ver el comentario equivalente en LineaFactura.varianteId.
  varianteId    String
  variante      VarianteProducto @relation(fields: [varianteId], references: [id])
  cantidad      Decimal          @db.Decimal(14, 4)
  costoUnitario Decimal          @db.Decimal(14, 4)

  @@map("linea_devolucion_compra")
}

/// Ledger de pagos — a diferencia de Factura.pagada/OrdenCompra.pagada
/// (booleanos derivados, ver PagosService), este es el registro real: uno
/// por cada abono, permitiendo pagos parciales con su método y fecha.
/// Exactamente uno de facturaId/ordenCompraId debe estar presente — no hay
/// forma declarativa de exigirlo en Prisma, se valida en PagosService.
model Pago {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facturaId      String?
  factura        Factura?     @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  ordenCompraId  String?
  ordenCompra    OrdenCompra? @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  monto          Decimal      @db.Decimal(14, 2)
  // Retención de ISR/ITBIS practicada al proveedor (Art. 309/349) — solo
  // aplica a pagos de OrdenCompra, ingresada a mano por quien registra el
  // pago (ver AsientosContablesService.generarDesdePagoOrdenCompra). Nunca
  // se usa en pagos de Factura; queda en 0 por defecto para no romper la
  // suma existente contra `orden.total` (ver PagosRepository.sumaPagosOrdenCompra).
  retencionIsr   Decimal      @default(0) @db.Decimal(14, 2)
  retencionItbis Decimal      @default(0) @db.Decimal(14, 2)
  formaPagoId    String
  formaPago      FormaPago    @relation(fields: [formaPagoId], references: [id])
  referencia     String?
  fecha          DateTime     @default(now())
  // Nullable (ítem C-1, Payment Link AZUL/CardNet) — un pago de gateway
  // público no tiene operador humano, mismo criterio ya usado por
  // PagoPlataforma.registradoPorId.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([facturaId])
  @@index([ordenCompraId])
  @@map("pagos")
}

// ============================================================
// CLIENTES
// ============================================================

enum TipoCliente {
  PERSONA_FISICA
  PERSONA_JURIDICA
}

model Cliente {
  id                    String                 @id @default(uuid())
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre                String
  tipo                  TipoCliente            @default(PERSONA_FISICA)
  rncCedula             String?
  email                 String?
  telefono              String?
  limiteCredito         Decimal                @default(0) @db.Decimal(14, 2)
  activo                Boolean                @default(true)
  // Contacto genérico sembrado al provisionar el tenant (ver
  // TenantsRepository.crearConProvisioning) — lo usa POS como cliente
  // por defecto en la venta rápida, para no exigir elegir un cliente
  // real en cada venta de mostrador.
  esConsumidorFinal     Boolean                @default(false)
  // Nivel de precio por defecto de este cliente (Fase 3b de adopción de
  // Cuadre) — null resuelve a "GENERAL" (ver FacturacionService.crear).
  // Se puede sobreescribir puntualmente al facturar/cotizar/vender en POS.
  listaPrecioId         String?
  listaPrecio           ListaPrecio?           @relation(fields: [listaPrecioId], references: [id], onDelete: SetNull)
  // Categoría/segmentación de cliente (plan de integración Cuadre, ítem
  // E-5) — catálogo propio, puramente informativo/de reporte (sin ningún
  // efecto en precios/permisos, a diferencia de listaPrecioId).
  categoriaId           String?
  categoria             CategoriaCliente?      @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  // Comprobante fiscal y condición de pago por defecto (ítem E-5,
  // separados a propósito — ver TipoComprobanteFiscal/CondicionPago):
  // autoseleccionan, cada uno por su lado, el comprobante fiscal y el
  // tipoFactura al elegir este cliente en Facturación/POS; el usuario
  // puede cambiar cualquiera de los dos antes de guardar, no es una
  // restricción, solo un valor inicial. Ver ModalNuevaFactura
  // (frontend) para el mapeo exacto.
  comprobanteFiscalPorDefecto TipoComprobanteFiscal?
  condicionPagoPorDefecto     CondicionPago?
  // Crédito general con este cliente (mismo criterio que
  // Proveedor.plazoPagoDias de Cuentas por Pagar) — precarga "Condición
  // de pago" (días de crédito) al facturarle a este cliente cuando la
  // condición de pago es CREDITO.
  plazoPagoDias               Int                    @default(30)
  createdAt                   DateTime               @default(now())
  // Ítem A-3 (Lealtad/puntos) — saldo denormalizado, mismo criterio que
  // `Stock.cantidadActual`: la fuente de verdad es la suma de
  // `MovimientoLealtad`, esto es una caché mantenida por
  // `LealtadService` para no tener que agregar en cada lectura.
  puntosLealtad         Int                    @default(0)

  direcciones        DireccionCliente[]
  facturas           Factura[]
  cotizaciones       Cotizacion[]
  remisiones         Remision[]
  ventasAparcadas    VentaAparcada[]
  movimientosLealtad MovimientoLealtad[]
  carritosBorrador   CarritoBorrador[]

  @@map("clientes")
}

/// Catálogo de categorías/segmentación de cliente (plan de integración
/// Cuadre, ítem E-5) — tenant-scoped, plano (sin jerarquía, a diferencia
/// de Categoria de producto: el dropdown de segmentación de Cuadre no
/// muestra ningún anidamiento).
model CategoriaCliente {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  clientes Cliente[]

  @@unique([tenantId, nombre])
  @@map("categorias_cliente")
}

/// Comprobante fiscal real de DGII — independiente de la condición de
/// pago (ver CondicionPago). Un cliente puede necesitar Crédito Fiscal
/// (B01) aunque pague de contado (lo necesita para su propia
/// declaración de ITBIS) — antes de este ítem, un solo campo
/// (ComprobantePorDefecto, ya eliminado) mezclaba los dos conceptos.
enum TipoComprobanteFiscal {
  CONSUMO
  CREDITO_FISCAL
  REGIMEN_ESPECIAL
  GUBERNAMENTAL
}

/// Si la venta se cobra al crearla (CONTADO) o queda pendiente en
/// Cuentas por Cobrar (CREDITO) — ver Factura.tipoFactura, que sigue
/// siendo el campo real que usa FacturacionService/CuentasPorCobrar/
/// Recordatorios; este enum es solo para los campos "por defecto" del
/// Cliente (dedicado, no reusa TipoFactura porque ese también tiene
/// NOTA_CREDITO/NOTA_DEBITO, que no aplican acá).
enum CondicionPago {
  CONTADO
  CREDITO
}

model DireccionCliente {
  id          String  @id @default(uuid())
  clienteId   String
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  direccion   String
  ciudad      String?
  esPrincipal Boolean @default(false)

  @@map("direccion_cliente")
}

// ============================================================
// WEBHOOKS (gestionados por el propio tenant)
// ============================================================

model Webhook {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  eventos   String[]
  secret    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  entregas WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  evento     String
  payload    Json
  statusCode Int?
  exitoso    Boolean  @default(false)
  intentos   Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("webhook_deliveries")
}

// ============================================================
// NOTIFICACIONES
// ============================================================

enum CanalNotificacion {
  EMAIL
  IN_APP
  WEBHOOK
  WHATSAPP
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  FALLIDA
}

model NotificacionPlantilla {
  id       String            @id @default(uuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  canal    CanalNotificacion
  clave    String
  asunto   String?
  cuerpo   String
  activa   Boolean           @default(true)

  @@unique([tenantId, canal, clave])
  @@map("notificacion_plantillas")
}

model Notificacion {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  canal        CanalNotificacion
  destinatario String
  asunto       String?
  cuerpo       String
  estado       EstadoNotificacion @default(PENDIENTE)
  createdAt    DateTime           @default(now())
  enviadaEn    DateTime?

  @@map("notificaciones")
}

/// BOGO agregado en el plan de integración Cuadre, ítem A-2 — cubre tanto
/// "Compra X Lleva Y" como "Segunda Unidad" (caso particular con
/// comprarCantidad=1, llevarCantidad=1) con un solo mecanismo genérico.
enum TipoDescuentoOferta {
  PORCENTAJE
  MONTO_FIJO
  BOGO
}

enum AlcanceOferta {
  PRODUCTO
  CATEGORIA
  CARRITO
}

/// Motor de descuentos automáticos (Fase 4b de adopción de Cuadre) — se
/// resuelve al facturar/vender (OfertasService), nunca se apila con otra
/// oferta que matchee la misma línea (se aplica la de mayor descuento
/// resultante, ver ARCHITECTURE.md). Solo aplica a ventas normales
/// (CONTADO/CREDITO) — nunca a NOTA_CREDITO/NOTA_DEBITO, que ajustan un
/// monto ya facturado, no una venta nueva. `productoId`/`categoriaId`/
/// `montoMinimoCarrito` son mutuamente exclusivos según `alcance`,
/// validado en OfertasService, no en el schema.
///
/// Plan de integración Cuadre, ítem A-2 — campos agregados:
/// `comprarCantidad`/`llevarCantidad`/`porcentajeDescuentoLlevar` (solo
/// BOGO, alcance PRODUCTO/CATEGORIA — nunca CARRITO, un "compra X lleva
/// Y" no tiene sentido sobre el total del carrito);
/// `descuentoMaximoMonto` (tope RD$, cualquier tipo); `acumulable`
/// (default `false` = comportamiento histórico, nunca se apilan) y
/// `prioridad` (desempate cuando hay más de una NO acumulable con el
/// mismo descuento resultante — ver OfertasService.combinarDescuentos);
/// `pagaComision` (ítem A-1 — Comisiones de venta: si es `false`, una
/// línea descontada por ESTA oferta no genera comisión de venta, "todo o
/// nada" — ver ComisionVenta/OfertasService.combinarDescuentos).
model Oferta {
  id                        String              @id @default(uuid())
  tenantId                  String
  tenant                    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre                    String
  tipoDescuento             TipoDescuentoOferta
  // % (0-100) si PORCENTAJE, monto RD$ si MONTO_FIJO — null si BOGO.
  valor                     Decimal?            @db.Decimal(14, 4)
  comprarCantidad           Int?
  llevarCantidad            Int?
  // % de descuento sobre las unidades "llevadas" — 100 = gratis (BOGO clásico), 50 = "segunda unidad a mitad de precio".
  porcentajeDescuentoLlevar Decimal?            @db.Decimal(5, 2)
  descuentoMaximoMonto      Decimal?            @db.Decimal(14, 2)
  acumulable                Boolean             @default(false)
  prioridad                 Int                 @default(0)
  pagaComision              Boolean             @default(true)
  alcance                   AlcanceOferta
  productoId                String?
  producto                  Producto?           @relation(fields: [productoId], references: [id], onDelete: Cascade)
  categoriaId               String?
  categoria                 Categoria?          @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  // Solo alcance=CARRITO — null significa "sin mínimo, siempre aplica".
  montoMinimoCarrito        Decimal?            @db.Decimal(14, 2)
  fechaInicio               DateTime
  fechaFin                  DateTime
  activa                    Boolean             @default(true)
  createdAt                 DateTime            @default(now())

  @@map("ofertas")
}

/// Comisión de venta de punta a punta (plan de integración Cuadre, ítem
/// A-1). Una fila por cada LineaFactura que genera comisión — nunca por
/// producto SERVICIO/COMBO sin `porcentajeComision`/`montoComisionFijo`
/// configurado, y nunca si la línea tiene `pagaComision: false` (Oferta
/// que no paga comisión) o la factura no tiene `vendedorEmpleadoId`
/// (solo ventas de POS con vendedor elegido, ítem F-2 — ver
/// ComisionesEventosService, reactor de `factura.creada`/
/// `factura.anulada`, corre fuera del request HTTP igual que
/// ContabilidadEventosService). `anulada` se marca `true` (nunca se
/// borra la fila) cuando la factura de origen se anula — igual criterio
/// de nunca perder rastro que Contabilidad, aunque esto no sea un
/// registro fiscal.
model ComisionVenta {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facturaId      String
  factura        Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  lineaFacturaId String
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id])
  empleadoId     String
  empleado       Empleado @relation(fields: [empleadoId], references: [id])
  monto          Decimal  @db.Decimal(14, 2)
  anulada        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([facturaId, lineaFacturaId])
  @@index([tenantId, empleadoId])
  @@index([tenantId, productoId])
  @@map("comisiones_venta")
}

enum ModoAcumulacionLealtad {
  POR_MONTO
  POR_UNIDAD
}

enum CalculoLealtad {
  SUBTOTAL
  TOTAL
}

/// Programa de lealtad/puntos (plan de integración Cuadre, ítem A-3) —
/// una fila por tenant (patrón "config única", igual criterio que
/// `PlataformaConfiguracion` pero tenant-scoped), apagado por defecto.
/// Apple/Google Wallet quedan fuera de este primer corte (decisión ya
/// registrada en el plan de integración).
model ConfiguracionLealtad {
  id                             String                 @id @default(uuid())
  tenantId                       String                 @unique
  tenant                         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activo                         Boolean                @default(false)
  modoAcumulacion                ModoAcumulacionLealtad @default(POR_MONTO)
  // Obligatorio (validado en LealtadService) cuando modoAcumulacion=POR_MONTO — RD$ por cada punto ganado.
  montoPorPunto                  Decimal?               @db.Decimal(14, 4)
  // Base de cálculo cuando modoAcumulacion=POR_MONTO — decisión confirmada con el usuario: configurable por tenant.
  calcularSobre                  CalculoLealtad         @default(SUBTOTAL)
  // Si es false, las líneas con descuento (manual, Oferta o descuento general) no aportan puntos.
  itemsConDescuentoGeneranPuntos Boolean                @default(true)
  // RD$ que vale UN punto al canjear (0 = no configurado, canje rechazado).
  valorPunto                     Decimal                @default(0) @db.Decimal(14, 4)
  minimoParaCanjear              Int                    @default(0)
  // null = los puntos nunca expiran.
  diasExpiracion                 Int?
  updatedAt                      DateTime               @updatedAt

  @@map("configuraciones_lealtad")
}

enum TipoMovimientoLealtad {
  ACUMULACION
  CANJE
  EXPIRACION
  AJUSTE
}

/// Ledger de puntos de lealtad (ítem A-3) — un `ACUMULACION` por venta
/// que gana puntos, con `puntosDisponibles` (mismo patrón FEFO que
/// `Lote`/`MovimientoInventario` de inventario) llevando cuánto de ESE
/// lote de puntos sigue sin canjear/expirar; `CANJE`/`EXPIRACION`
/// descuentan de los lotes más próximos a vencer primero (o los más
/// viejos si no expiran). `anulado` (nunca se borra una fila) se marca
/// cuando la factura de origen se anula — ver ARCHITECTURE.md para el
/// alcance exacto de la reversión.
model MovimientoLealtad {
  id                String                @id @default(uuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId         String
  cliente           Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo              TipoMovimientoLealtad
  // + en ACUMULACION/AJUSTE positivo, - en CANJE/EXPIRACION/AJUSTE negativo.
  puntos            Int
  // Solo tiene sentido en ACUMULACION — cuánto de este lote sigue disponible.
  puntosDisponibles Int                   @default(0)
  facturaId         String?
  factura           Factura?              @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  expiraEn          DateTime?
  motivo            String?
  anulado           Boolean               @default(false)
  createdAt         DateTime              @default(now())

  @@index([tenantId, clienteId])
  @@index([tenantId, expiraEn])
  @@map("movimientos_lealtad")
}

enum EstadoBono {
  ACTIVO
  AGOTADO
  VENCIDO
  ANULADO
}

/// Gift card emitida por lote (Fase 4c de adopción de Cuadre), canjeable
/// como forma de pago en el POS. Sin tabla de movimientos propia — el
/// ledger de canjes YA es `PagoVenta` (filtrado por `formaPago.esBono`
/// y `referencia = codigo`), mismo criterio que MovimientoInventario es
/// el único ledger de stock: no duplicar lo que ya se registra en otro
/// lado. `saldoActual` es la única fuente de verdad sobre cuánto queda,
/// actualizada atómicamente dentro de la misma transacción que crea la
/// factura que lo canjea (BonosService.procesarPagoEnTx).
model Bono {
  id               String     @id @default(uuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codigo           String
  montoInicial     Decimal    @db.Decimal(14, 2)
  saldoActual      Decimal    @db.Decimal(14, 2)
  fechaVencimiento DateTime
  estado           EstadoBono @default(ACTIVO)
  createdAt        DateTime   @default(now())

  @@unique([tenantId, codigo])
  @@map("bonos")
}
